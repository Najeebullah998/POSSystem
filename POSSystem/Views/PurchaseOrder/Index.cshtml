@{
    ViewData["Title"] = "Suppliers";
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<div class="page-inner">

    <div class="row mb-1">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <div class="input-group ms-1">
                        <input type="text" class="form-control form-control-light" id="dash-daterange">
                        <span class="input-group-text bg-primary border-primary text-white">
                            <i class="mdi mdi-calendar-range font-13"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center flex-wrap p-1 pb-0 gap-2">

                    <div class="d-flex flex-wrap gap-2">
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">Go Back</a>
                    </div>

                    <div>
                        <a href="/PurchaseOrder/CreatePurchseOrder"
                           class="btn btn-primary listbuttons">
                            New Purchase Order
                        </a>
                    </div>

                </div>

                <div class="card-body">

                    <div class="dataTables_wrapper">

                        <table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">

                            <thead>
                                <tr>
                                    <th>PO Number</th>
                                    <th>PO Date</th>
                                    <th>Supplier</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody></tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>


       $(document).ready(function () {

        loadPurchaseOrders();

    });

        function formatDate(date) {
        return new Date(date).toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        });
    }

        function loadPurchaseOrders() {

        $.ajax({

            url: '/PurchaseOrder/GetPurchaseList',
            type: 'GET',

            success: function (data) {

                var tbody = $("#datatable-buttons tbody");

                tbody.empty();

                $.each(data, function (i, po) {

                    tbody.append(`
                        <tr>
                            <td>${po.poNumber}</td>
                           <td>${formatDate(po.poDate)}</td>
                            <td>${po.supplierName}</td>
                            <td>${po.totalAmount}</td>
                            <td>${po.status}</td>
                            <td class="text-center">

                                <a href="/PurchaseOrder/Index?id=${po.purchaseOrderId}"
                                   class="btn btn-success btn-sm">
                                   Edit
                                </a>

                                <button class="btn btn-danger btn-sm"
                                        onclick="deletePurchaseOrder(${po.purchaseOrderId})">
                                    Delete
                                </button>

                                <a href="/PurchaseOrder/Print?id=${po.purchaseOrderId}"
                                   class="btn btn-info btn-sm">
                                   Print
                                </a>

                                <a href="/GRN/Index?purchaseOrderId=${po.purchaseOrderId}"
                                   class="btn btn-warning btn-sm">
                                   GRN
                                </a>

                            </td>
                        </tr>
                    `);

                });

            }

        });

    }

    

        function deletePurchaseOrder(id) {

        Swal.fire({
            title: "Are you sure?",
            text: "This Purchase Order will be deleted.",
            icon: "warning",
            showCancelButton: true
        }).then((result) => {

            if (result.isConfirmed) {

                $.post("/PurchaseOrder/Delete?id=" + id, function (res) {

                    if (res.success) {

                        Swal.fire("Deleted!", res.message, "success");

                        loadPurchaseOrders();

                    }

                });

            }

        });

    }

</script>