@{
    ViewData["Title"] = "Unit List";
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<div class="page-inner">

    <!-- start page title -->
    <div class="row mb-1">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <div class="input-group ms-1">
                        <input type="text"
                               class="form-control form-control-light"
                               id="dash-daterange">

                        <span class="input-group-text bg-primary border-primary text-white">
                            <i class="mdi mdi-calendar-range font-13"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end page title -->


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center flex-wrap p-1 pb-0 gap-2">

                    <!-- Left -->
                    <div class="d-flex flex-wrap gap-2">

                        <a href="javascript:void(0);"
                           class="btn btn-primary listbuttons">
                            Go Back
                        </a>

                    </div>

                    <!-- Right -->
                    <div>
                        <a onclick="openAddModal()"
                           class="btn btn-primary listbuttons">
                            Create
                        </a>
                    </div>

                </div>


                <div class="card-body">

                    <div class="dataTables_wrapper">

                        <table id="datatable-buttons"
                               class="table table-striped dt-responsive nowrap w-100">

                            <thead>
                                <tr>
                                    <th>Unit Name</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>


<!-- Unit Modal -->
<div class="modal fade"
     id="unitModal"
     tabindex="-1"
     aria-labelledby="modalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="modalTitle">
                    Add Unit
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <input type="hidden"
                       id="unitId"
                       value="0" />

                <div class="mb-3">

                    <label for="unitName"
                           class="form-label">
                        Unit Name
                    </label>

                    <input type="text"
                           class="form-control"
                           id="unitName"
                           placeholder="Enter unit name"
                           maxlength="20" />

                </div>


                <div class="form-check form-switch">

                    <input class="form-check-input"
                           type="checkbox"
                           id="IsActive"
                           checked>

                    <label class="form-check-label"
                           for="IsActive">
                        Active
                    </label>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="saveUnit()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>


<script>

    // ==============================
    // Bootstrap Modal
    // ==============================

    var unitModal = new bootstrap.Modal(
        document.getElementById('unitModal')
    );


    // ==============================
    // Load Units
    // ==============================

    function loadUnits() {

        $.ajax({

            url: '/Unit/GetAll',

            type: 'GET',

            success: function(response) {

                var tbody = $('#datatable-buttons tbody');

                tbody.empty();

                if (!response.success) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.message
                    });

                    return;
                }


                $.each(response.data, function(i, unit) {

                    var status = unit.isActive
                        ? 'Active'
                        : 'Inactive';


                    var row = `
                            <tr>

                                <td>
                                    ${unit.unitName}
                                </td>

                                <td>
                                    ${status}
                                </td>

                                <td class="text-center">

                                    <button type="button"
                                            class="btn btn-sm btn-success"
                                            onclick="editUnit(${unit.unitId})">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="deleteUnit(${unit.unitId})">
                                        Delete
                                    </button>

                                </td>

                            </tr>
                        `;

                    tbody.append(row);

                });

            },

            error: function() {

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to load units.'
                });

            }

        });

    }


    // ==============================
    // Open Add Modal
    // ==============================

    function openAddModal() {

        $('#modalTitle').text('Add Unit');

        $('#unitId').val(0);

        $('#unitName').val('');

        $('#IsActive').prop('checked', true);

        unitModal.show();

    }


    // ==============================
    // Save / Update Unit
    // ==============================

    function saveUnit() {

        var unitName = $('#unitName').val();

        console.log("Unit Name:", unitName);

        var unit = {
            UnitId: parseInt($('#unitId').val()) || 0,
            UnitName: unitName,
            IsActive: $('#IsActive').is(':checked')
        };

        console.log("Sending:", unit);

        if (unit.UnitName.trim() === '') {

            Swal.fire({
                icon: 'warning',
                title: 'Required',
                text: 'Please enter unit name.'
            });

            return;
        }


        $.ajax({

            url: '/Unit/Save',

            type: 'POST',

            contentType: 'application/json; charset=utf-8',

            dataType: 'json',

            data: JSON.stringify(unit),

            success: function(response) {

                if (response.success) {

                    unitModal.hide();

                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function() {
                        loadUnits();
                    });

                }
                else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.message
                    });

                }
            },

            error: function(xhr) {

                console.log("ERROR:", xhr.responseText);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong!'
                });

            }

        });

    }


    // ==============================
    // Edit Unit
    // ==============================

    function editUnit(id) {

        $.ajax({

            url: '/Unit/GetById?id=' + id,

            type: 'GET',

            success: function(response) {

                if (!response.success) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.message
                    });

                    return;
                }


                var unit = response.data;


                $('#modalTitle').text('Edit Unit');

                $('#unitId').val(unit.unitId);

                $('#unitName').val(unit.unitName);

                $('#IsActive').prop(
                    'checked',
                    unit.isActive
                );


                unitModal.show();

            },

            error: function() {

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to load unit.'
                });

            }

        });

    }


    // ==============================
    // Delete Unit
    // ==============================

    function deleteUnit(id) {

        Swal.fire({

            title: 'Are you sure?',

            text: 'This unit will be deleted!',

            icon: 'warning',

            showCancelButton: true,

            confirmButtonText: 'Yes, delete it!'

        }).then(function(result) {

            if (result.isConfirmed) {

                $.ajax({

                    url: '/Unit/Delete?id=' + id,

                    type: 'POST',

                    success: function(response) {

                        if (response.success) {

                            Swal.fire({

                                icon: 'success',

                                title: 'Deleted!',

                                text: response.message,

                                timer: 1500,

                                showConfirmButton: false

                            }).then(function() {

                                loadUnits();

                            });

                        }
                        else {

                            Swal.fire({

                                icon: 'error',

                                title: 'Error',

                                text: response.message

                            });

                        }

                    },

                    error: function() {

                        Swal.fire({

                            icon: 'error',

                            title: 'Error',

                            text: 'Something went wrong!'

                        });

                    }

                });

            }

        });

    }


    // ==============================
    // Page Load
    // ==============================

    $(document).ready(function() {

        loadUnits();

    });

</script>