@model POSSystem.Entities.GRNHeaderVM

@* @{
    ViewBag.Title = "Create GRN";
} *@

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<style>
    :root {
        --primary-color: #4361ee;
        --primary-dark: #3a56d4;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --dark-color: #1f2937;
        --light-bg: #f9fafb;
        --border-color: #e5e7eb;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding-bottom: 120px;
        min-height: 100vh;
    }

    /* ============================================
           MAIN CONTAINER
           ============================================ */

    .grn-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
    }

    /* ============================================
           CARDS
           ============================================ */

    .grn-card {
        background: white;
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .grn-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
        }

    .card-header-grn {
        background: linear-gradient(135deg, var(--info-color) 0%, #2563eb 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: 0.5px;
    }

    .card-header-success {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
    }

    .card-body-custom {
        padding: 25px;
    }

    /* ============================================
           FORM ELEMENTS
           ============================================ */

    .form-label-modern {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
    }

    .form-control-modern {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 12px;
        transition: all 0.3s;
        font-size: 14px;
        width: 100%;
    }

        .form-control-modern:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

        .form-control-modern:disabled,
        .form-control-modern[readonly] {
            background: #f3f4f6;
            cursor: not-allowed;
        }

    /* ============================================
           SELECT2
           ============================================ */

    .select2-container .select2-selection--single {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        height: 44px;
        padding: 5px;
    }

    .select2-container--focus .select2-selection--single {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }

    .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 32px;
        padding-left: 8px;
    }

    .select2-container .select2-selection--single .select2-selection__arrow {
        height: 40px;
    }

    /* ============================================
           PO SELECTION
           ============================================ */

    .po-selection-section {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 2px solid var(--info-color);
    }

    /* ============================================
           TABLE CONTAINER
           ============================================ */

    .grn-table-container {
        width: 100%;
        overflow: hidden;
        border-radius: 12px;
        background: white;
        border: 1px solid var(--border-color);
    }

    .table-wrapper {
        max-height: calc(100vh - 500px);
        overflow-x: auto;
        overflow-y: auto;
        border-radius: 12px;
        background: white;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    /* ============================================
           GRN TABLE
           ============================================ */

    .grn-table {
        width: max-content;
        min-width: 100%;
        table-layout: auto;
        border-collapse: collapse;
    }

        .grn-table thead th {
            background: var(--dark-color);
            color: white;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 12px 10px;
            position: sticky;
            top: 0;
            z-index: 10;
            border: none;
            white-space: nowrap;
            vertical-align: middle;
        }

        .grn-table tbody tr {
            transition: background 0.2s;
            border-bottom: 1px solid var(--border-color);
            animation: slideIn 0.3s ease-out;
        }

            .grn-table tbody tr:hover {
                background: #f8f9ff;
            }

        .grn-table tbody td {
            padding: 10px;
            vertical-align: middle;
            white-space: nowrap;
        }

        /* ============================================
           NORMAL COLUMNS
           ============================================ */

        .grn-table th:nth-child(1),
        .grn-table td:nth-child(1) {
            min-width: 50px;
            width: 50px;
            text-align: center;
        }

        .grn-table th:nth-child(2),
        .grn-table td:nth-child(2) {
            min-width: 220px;
            width: 220px;
        }

        .grn-table th:nth-child(3),
        .grn-table td:nth-child(3) {
            min-width: 100px;
            width: 100px;
            text-align: center;
        }

        .grn-table th:nth-child(4),
        .grn-table td:nth-child(4) {
            min-width: 110px;
            width: 110px;
            text-align: center;
        }

        .grn-table th:nth-child(5),
        .grn-table td:nth-child(5) {
            min-width: 120px;
            width: 120px;
            text-align: center;
        }

        /* ============================================
           RATE COLUMN
           ============================================ */

        .grn-table .rate {
            min-width: 100px;
            width: 100px;
            text-align: right;
        }

        /* ============================================
           RECEIVED QTY
           ============================================ */

        .grn-table .receivedQty {
            width: 90px;
            min-width: 90px;
            text-align: center;
            margin: auto;
        }

        /* ============================================
           PHARMACY COLUMNS
           ============================================ */

        .grn-table .batchNo {
            width: 120px;
            min-width: 120px;
        }

        .grn-table .manufacturingDate,
        .grn-table .expiryDate {
            width: 130px;
            min-width: 130px;
        }

        .grn-table .retailRate {
            width: 110px;
            min-width: 110px;
        }

        .grn-table .supplierDiscount {
            width: 125px;
            min-width: 125px;
        }

        .grn-table .costRate {
            width: 110px;
            min-width: 110px;
            text-align: right;
            font-weight: 600;
        }

        /* ============================================
           AMOUNT
           ============================================ */

        .grn-table .amount {
            min-width: 120px;
            width: 120px;
            text-align: right;
            font-weight: 600;
        }

        /* ============================================
           STATUS
           ============================================ */

        .grn-table .status {
            min-width: 110px;
            width: 110px;
            text-align: center;
        }

    .badge-status {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-received {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-partial {
        background: #dbeafe;
        color: #1e40af;
    }

    /* ============================================
           TABLE INPUTS
           ============================================ */

    .grn-table input.form-control {
        height: 38px;
        font-size: 13px;
        border-radius: 7px;
    }

        .grn-table input.form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

    .grn-table .qty-input {
        width: 100px;
        text-align: center;
        border-radius: 8px;
        border: 2px solid var(--border-color);
        padding: 6px 10px;
        transition: all 0.3s;
    }

        .grn-table .qty-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

        .grn-table .qty-input:disabled {
            background: #f3f4f6;
            cursor: not-allowed;
        }

    /* ============================================
           TABLE SCROLLBAR
           ============================================ */

    .table-wrapper::-webkit-scrollbar {
        height: 10px;
        width: 8px;
    }

    .table-wrapper::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }

    .table-wrapper::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 10px;
    }

        .table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

    /* ============================================
           FOOTER
           ============================================ */

    .grn-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 3px solid var(--info-color);
        box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        padding: 20px 30px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        align-items: center;
    }

    .footer-card {
        background: var(--light-bg);
        padding: 12px 18px;
        border-radius: 12px;
        transition: all 0.3s;
    }

        .footer-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

    .footer-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 3px;
    }

    .footer-value {
        font-size: 22px;
        font-weight: 700;
        color: var(--dark-color);
        margin: 0;
    }

    .footer-value-success {
        color: var(--success-color);
    }

    /* ============================================
           BUTTONS
           ============================================ */

    .btn-save-grn {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .btn-save-grn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3);
        }

    .btn-clear-grn {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .btn-clear-grn:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    /* ============================================
           ANIMATION
           ============================================ */

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* ============================================
           RESPONSIVE
           ============================================ */

    @@media (max-width: 768px) {
        .grn-container {
            padding: 10px;
        }

        .grn-footer {
            padding: 15px;
        }

        .footer-grid {
            grid-template-columns: 1fr;
        }

        .table-wrapper {
            max-height: calc(100vh - 450px);
        }

        .grn-table thead th {
            font-size: 11px;
            padding: 10px 8px;
        }

        .grn-table tbody td {
            padding: 8px;
        }
    }

    /* ============================================
           PRINT
           ============================================ */

    @@media print {
        body * {
            visibility: hidden;
        }

        #printArea,
        #printArea * {
            visibility: visible;
        }

        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: white;
            padding: 20px;
        }
    }
</style>
@{
    bool isPharmacy = string.Equals(
        Context.Session.GetString("BusinessTypeName")?.Trim(),
        "Pharmacy",
        StringComparison.OrdinalIgnoreCase
    );
}
<div class="grn-container">
    <!-- GRN Header Card -->
    <div class="grn-card">
        <div class="card-header-grn">
            <i class="fas fa-clipboard-check"></i> Goods Receipt Note
        </div>
        <div class="card-body-custom">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-hashtag"></i> GRN Number
                    </label>
                    <input type="text" id="GRNNumber" class="form-control-modern" value="@Model.GRNNumber" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="far fa-calendar-alt"></i> GRN Date
                    </label>
                    <input type="date" id="GRNDate" class="form-control-modern" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-file-invoice"></i> Purchase Order
                    </label>
                    <select asp-for="PurchaseOrderId"
                            asp-items="Model.PurchaseOrderList"
                            class="form-control select2">
                        <option value="">Select Purchase Order</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-truck"></i> Supplier
                    </label>
                    <select asp-for="SupplierId"
                            asp-items="Model.SupplierList"
                            class="form-control select2">
                        <option value="">Select Supplier</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-warehouse"></i> Warehouse
                    </label>
                    <select asp-for="WarehouseId"
                            asp-items="Model.WarehouseList"
                            class="form-control select2">
                        <option value="">Select Warehouse</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- PO Items Card -->
    <div class="grn-card">
        <div class="card-header-grn">
            <i class="fas fa-boxes"></i> Items Receiving
        </div>
        <div class="card-body-custom">
            <!-- PO Selection Info -->
            <div class="po-selection-section">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <i class="fas fa-info-circle" style="color: var(--info-color);"></i>
                        <span style="font-weight: 600; color: #1e40af;">Select a Purchase Order to load items</span>
                        <span id="poInfo" style="margin-left: 15px; color: #6b7280;"></span>
                    </div>
                    <div class="col-md-4 text-end">
                        <button class="btn btn-primary" onclick="loadPOItems()" style="border-radius: 10px;">
                            <i class="fas fa-sync-alt"></i> Load PO Items
                        </button>
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="grn-table-container">
                <div class="table-wrapper">
                    <table class="grn-table" id="grnTable">
                        <thead>
                            <tr>
                                <th style="width:5%;text-align:center">#</th>
                                <th style="width:25%">Item Name</th>
                                <th style="width:10%;text-align:center">Order Qty</th>
                                <th style="width:10%;text-align:center">Pending Qty</th>
                                <th style="width:12%;text-align:center">Received Qty</th>
                                <th style="width:10%;text-align:right">Rate</th>

                                @if (isPharmacy)
                                {
                                    <th style="width:12%; min-width:120px; text-align:center">Batch No</th>
                                    <th style="width:12%; min-width:130px; text-align:center">MFG Date</th>
                                    <th style="width:12%; min-width:130px; text-align:center">Expiry Date</th>
                                    <th style="width:12%; min-width:120px; text-align:center">Retail Rate</th>
                                    <th style="width:12%; min-width:130px; text-align:center">Supplier Discount (%)</th>
                                    <th style="width:12%; min-width:120px; text-align:center">Cost Rate</th>
                                }

                                <th style="width:10%;text-align:right">Amount</th>
                                <th style="width:8%;text-align:center">Status</th>
                            </tr>
                        </thead>

                        <tbody id="tblBody">
                            <tr class="text-center">
                                <td colspan="@(isPharmacy ? 12 : 8)" style="padding:60px 20px;">
                                    <i class="fas fa-inbox" style="font-size:48px;color:#cbd5e1;"></i>
                                    <p style="color:#94a3b8;margin-top:15px;">
                                        Select a PO and click "Load PO Items" to begin
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Remarks Card -->
    <div class="grn-card">
        <div class="card-body-custom">
            <div class="row">
                <div class="col-md-12">
                    <label class="form-label-modern">
                        <i class="fas fa-comment"></i> Remarks
                    </label>
                    <textarea id="Remarks" class="form-control-modern" rows="2" placeholder="Enter any remarks here..."></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer Section -->
<div class="grn-footer">
    <div class="footer-grid">
        <div class="footer-card">
            <div class="footer-label">Total Items</div>
            <div class="footer-value" id="TotalItems">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Total Order Qty</div>
            <div class="footer-value" id="TotalOrderQty">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Total Received Qty</div>
            <div class="footer-value footer-value-success" id="TotalReceivedQty">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Total Amount (Rs)</div>
            <div class="footer-value" id="TotalAmount">0.00</div>
        </div>

        <div>
            <button class="btn-save-grn" id="btnSaveGRN">
                <i class="fas fa-save"></i> Save GRN
            </button>
        </div>

        <div>
            <button class="btn-clear-grn" onclick="clearAll()">
                <i class="fas fa-trash-alt"></i> Clear
            </button>
        </div>
    </div>
</div>

<!-- Print Template -->
<div id="printArea" style="display:none;">
    <div style="padding: 20px;">
        <h2 style="text-align: center;">Goods Receipt Note</h2>
        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <tr>
                <td><strong>GRN #:</strong> <span id="pGRNNumber"></span></td>
                <td><strong>Date:</strong> <span id="pGRNDate"></span></td>
            </tr>
            <tr>
                <td><strong>Supplier:</strong> <span id="pSupplier"></span></td>
                <td><strong>PO #:</strong> <span id="pPONumber"></span></td>
            </tr>
        </table>

        <table style="width: 100%; border-collapse: collapse; margin-top: 20px; border: 1px solid #000;">
            <thead>
                <tr style="background: #1f2937; color: white;">
                    <th style="padding: 8px; border: 1px solid #000;">#</th>
                    <th style="padding: 8px; border: 1px solid #000;">Item</th>
                    <th style="padding: 8px; border: 1px solid #000;">Order Qty</th>
                    <th style="padding: 8px; border: 1px solid #000;">Received Qty</th>
                    <th style="padding: 8px; border: 1px solid #000;">Rate</th>
                    <th style="padding: 8px; border: 1px solid #000;">Amount</th>
                </tr>
            </thead>
            <tbody id="printItems"></tbody>
            <tfoot>
                <tr>
                    <td colspan="4" style="padding: 8px; border: 1px solid #000; text-align: right;"><strong>Total:</strong></td>
                    <td colspan="2" style="padding: 8px; border: 1px solid #000;" id="pTotalAmount"></td>
                </tr>
            </tfoot>
        </table>

        <p style="margin-top: 20px;"><strong>Remarks:</strong> <span id="pRemarks"></span></p>
        <input type="hidden" id="BranchId" value="1" />
        <input type="hidden" id="CreatedBy" value="1" />
     @*    <input type="hidden" id="WarehouseId" value="2" /> *@
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>

<script>
    let grnItems = [];
    let rowIndex = 0;

    $(document).ready(function() {

        // Initialize Select2
        $('.select2').select2({
            placeholder: 'Select option',
            allowClear: true,
            width: '100%'
        });

        $("#PurchaseOrderId").change(function() {

            let id = $(this).val();

            if (id == "")
                return;

            $.ajax({

                url: '/CreateGRN/GetPurchaseOrder',

                type: 'GET',

                data: { id: id },

                success: function(res) {

                    if (!res.success)
                        return;

                    let h = res.data;

                    $("#SupplierId")
                        .val(h.supplierId)
                        .trigger("change");

                    $("#WarehouseId")
                        .val(h.warehouseId)
                        .trigger("change");

                    loadGrid(h.details);

                }

            });

        });
    });


    function loadGrid(items) {

        $("#tblBody").empty();

        const isPharmacy = @Json.Serialize(isPharmacy);

        $.each(items, function(i, item) {

            let orderQty = parseFloat(item.orderQty) || 0;
            let pendingQty = parseFloat(item.pendingQty) || 0;

            // Purchase Order Rate
            let rate = parseFloat(item.rate) || 0;

            if (pendingQty <= 0 && orderQty > 0) {
                pendingQty = orderQty;
            }

            let status = "";

            if (pendingQty == 0) {
                status = '<span class="badge bg-success">Completed</span>';
            }
            else if (pendingQty < orderQty) {
                status = '<span class="badge bg-warning">Partial</span>';
            }
            else {
                status = '<span class="badge bg-secondary">Pending</span>';
            }


            let pharmacyColumns = "";

            if (isPharmacy) {

                const currentDate =
                    new Date().toISOString().split('T')[0];

                pharmacyColumns = `

                        <td>
                            <input type="text"
                                   class="form-control form-control-sm batchNo"
                                   placeholder="Batch No">
                        </td>

                        <td>
                            <input type="date"
                                   class="form-control form-control-sm manufacturingDate"
                                   value="${currentDate}">
                        </td>

                        <td>
                            <input type="date"
                                   class="form-control form-control-sm expiryDate"
                                   value="${currentDate}">
                        </td>

                        <!-- Retail Rate -->
                        <td>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control form-control-sm text-center retailRate"
                                   value="${rate.toFixed(2)}">
                        </td>

                        <!-- Supplier Discount -->
                        <td>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   class="form-control form-control-sm text-center supplierDiscount"
                                   value="0">
                        </td>

                        <!-- Cost Rate -->
                        <td class="text-end costRate">
                            ${rate.toFixed(2)}
                        </td>
                    `;
            }


            let row = `

                    <tr>

                        <td class="text-center">
                            ${i + 1}
                        </td>

                        <td>

                            <input type="hidden"
                                   class="itemId"
                                   value="${item.itemId}" />

                            ${item.itemName}

                        </td>

                        <td class="text-center orderQty">
                            ${orderQty.toFixed(2)}
                        </td>

                        <td class="text-center pendingQty"
                            data-original="${pendingQty}">

                            ${pendingQty.toFixed(2)}

                        </td>

                        <td style="width:120px;">

                            <input type="number"
                                   class="form-control text-center receivedQty"
                                   min="0"
                                   max="${pendingQty}"
                                   step="0.01"
                                   value="0">

                        </td>

                        <!-- Normal Rate -->
                        <td class="text-end rate">
                            ${rate.toFixed(2)}
                        </td>

                        ${pharmacyColumns}

                        <td class="text-end amount">
                            0.00
                        </td>

                        <td class="text-center status">
                            ${status}
                        </td>

                    </tr>
                `;

            $("#tblBody").append(row);
        });

        calculateFooter();
    }


    // ============================================================
    // RECEIVED QTY CALCULATION
    // ============================================================

    $(document).on("input", ".receivedQty", function() {

        let row = $(this).closest("tr");

        let originalPending =
            parseFloat(
                row.find(".pendingQty")
                    .attr("data-original")
            ) || 0;

        let receivedQty =
            parseFloat($(this).val()) || 0;


        // Quantity validation
        if (receivedQty < 0) {

            receivedQty = 0;

            $(this).val(0);
        }


        if (receivedQty > originalPending) {

            Swal.fire({
                icon: "warning",
                title: "Invalid Quantity",
                text: "Received Quantity cannot be greater than Pending Quantity."
            });

            receivedQty = originalPending;

            $(this).val(originalPending);
        }


        // Remaining Pending
        let remaining =
            originalPending - receivedQty;

        row.find(".pendingQty")
            .text(remaining.toFixed(2));


        // ========================================================
        // AMOUNT CALCULATION
        // ========================================================

        const isPharmacy = @Json.Serialize(isPharmacy);

        let amount = 0;


        if (isPharmacy) {

            // Retail Rate
            let retailRate =
                parseFloat(
                    row.find(".retailRate").val()
                ) || 0;

            // Supplier Discount %
            let supplierDiscount =
                parseFloat(
                    row.find(".supplierDiscount").val()
                ) || 0;


            // Discount validation
            if (supplierDiscount < 0) {

                supplierDiscount = 0;

                row.find(".supplierDiscount").val(0);
            }

            if (supplierDiscount > 100) {

                supplierDiscount = 100;

                row.find(".supplierDiscount").val(100);
            }


            // Discount Amount
            let discountAmount =
                retailRate * supplierDiscount / 100;


            // Cost Rate
            let costRate =
                retailRate - discountAmount;


            // Display Cost Rate
            row.find(".costRate")
                .text(costRate.toFixed(2));


            // Amount
            amount =
                receivedQty * costRate;

        }
        else {

            // Normal business
            let rate =
                parseFloat(
                    row.find(".rate").text()
                ) || 0;

            amount =
                receivedQty * rate;
        }


        // Display Amount
        row.find(".amount")
            .text(amount.toFixed(2));


        // ========================================================
        // STATUS
        // ========================================================

        let status = "";

        if (remaining == 0) {

            status =
                '<span class="badge bg-success">Completed</span>';

        }
        else if (remaining < originalPending) {

            status =
                '<span class="badge bg-warning">Partial</span>';

        }
        else {

            status =
                '<span class="badge bg-secondary">Pending</span>';
        }


        row.find(".status")
            .html(status);


        calculateFooter();
    });


    // ============================================================
    // PHARMACY RETAIL RATE / DISCOUNT CHANGE
    // ============================================================

    $(document).on(
        "input",
        ".retailRate, .supplierDiscount",
        function() {

            const isPharmacy = @Json.Serialize(isPharmacy);

            if (!isPharmacy)
                return;

            let row = $(this).closest("tr");


            let retailRate =
                parseFloat(
                    row.find(".retailRate").val()
                ) || 0;


            let supplierDiscount =
                parseFloat(
                    row.find(".supplierDiscount").val()
                ) || 0;


            // Validate discount
            if (supplierDiscount < 0) {

                supplierDiscount = 0;

                row.find(".supplierDiscount").val(0);
            }


            if (supplierDiscount > 100) {

                supplierDiscount = 100;

                row.find(".supplierDiscount").val(100);
            }


            // ====================================================
            // DISCOUNT AMOUNT
            // ====================================================

            let discountAmount =
                retailRate * supplierDiscount / 100;


            // ====================================================
            // COST RATE
            // ====================================================

            let costRate =
                retailRate - discountAmount;


            row.find(".costRate")
                .text(costRate.toFixed(2));


            // ====================================================
            // AMOUNT
            // ====================================================

            let receivedQty =
                parseFloat(
                    row.find(".receivedQty").val()
                ) || 0;


            let amount =
                receivedQty * costRate;


            row.find(".amount")
                .text(amount.toFixed(2));


            calculateFooter();
        }
    );


    // ============================================================
    // FOOTER CALCULATION
    // ============================================================

    function calculateFooter() {

        let totalItems = 0;
        let totalOrderQty = 0;
        let totalReceivedQty = 0;
        let totalAmount = 0;


        $("#tblBody tr").each(function() {

            // Empty row ignore karo
            if ($(this).find(".itemId").length == 0)
                return;


            totalItems++;


            totalOrderQty +=
                parseFloat(
                    $(this).find(".orderQty").text()
                ) || 0;


            totalReceivedQty +=
                parseFloat(
                    $(this).find(".receivedQty").val()
                ) || 0;


            totalAmount +=
                parseFloat(
                    $(this).find(".amount").text()
                ) || 0;

        });


        $("#TotalItems")
            .text(totalItems);


        $("#TotalOrderQty")
            .text(totalOrderQty.toFixed(2));


        $("#TotalReceivedQty")
            .text(totalReceivedQty.toFixed(2));


        $("#TotalAmount")
            .text(totalAmount.toFixed(2));
    }


    // ============================================================
    // SAVE GRN
    // ============================================================

  
    $("#btnSaveGRN").click(function () {

        const isPharmacy = @Json.Serialize(isPharmacy);

        var details = [];
        var validationFailed = false;


        // ========================================================
        // LOOP GRN DETAILS
        // ========================================================

        $("#tblBody tr").each(function () {

            if ($(this).find(".itemId").length == 0)
                return;


            let row = $(this);


            let receivedQty =
                parseFloat(
                    row.find(".receivedQty").val()
                ) || 0;


            // Received Qty nahi hai to ignore
            if (receivedQty <= 0)
                return;


            // ====================================================
            // BASIC DETAIL
            // ====================================================

            let detail = {

                ItemId:
                    parseInt(
                        row.find(".itemId").val()
                    ),

                ReceivedQty:
                    receivedQty,

                Rate:
                    parseFloat(
                        row.find(".rate").text()
                    ) || 0,

                Amount:
                    parseFloat(
                        row.find(".amount").text()
                    ) || 0
            };


            // ====================================================
            // PHARMACY
            // ====================================================

            if (isPharmacy) {

                let batchNo =
                    row.find(".batchNo")
                        .val()
                        ?.trim();


                let mfgDate =
                    row.find(".manufacturingDate")
                        .val();


                let expiryDate =
                    row.find(".expiryDate")
                        .val();


                let retailRate =
                    parseFloat(
                        row.find(".retailRate").val()
                    ) || 0;


                let supplierDiscount =
                    parseFloat(
                        row.find(".supplierDiscount").val()
                    ) || 0;


                // =================================================
                // Calculate Cost Rate
                // =================================================

                let costRate =
                    retailRate -
                    (
                        retailRate *
                        supplierDiscount /
                        100
                    );


                // =================================================
                // Validation
                // =================================================

                if (!batchNo || !mfgDate || !expiryDate) {

                    validationFailed = true;


                    if (!batchNo) {

                        row.find(".batchNo").focus();

                    }
                    else if (!mfgDate) {

                        row.find(".manufacturingDate").focus();

                    }
                    else {

                        row.find(".expiryDate").focus();
                    }

                    return;
                }


                // MFG Date > Expiry Date
                if (
                    new Date(mfgDate) >
                    new Date(expiryDate)
                ) {

                    validationFailed = true;


                    Swal.fire({

                        icon: "warning",

                        title: "Invalid Dates",

                        text:
                            "Manufacturing Date cannot be greater than Expiry Date."
                    });


                    row.find(".manufacturingDate").focus();

                    return;
                }


                // Discount validation
                if (
                    supplierDiscount < 0 ||
                    supplierDiscount > 100
                ) {

                    validationFailed = true;


                    Swal.fire({

                        icon: "warning",

                        title: "Invalid Discount",

                        text:
                            "Supplier Discount must be between 0 and 100%."
                    });


                    row.find(".supplierDiscount").focus();

                    return;
                }


                // Retail Rate validation
                if (retailRate <= 0) {

                    validationFailed = true;


                    Swal.fire({

                        icon: "warning",

                        title: "Invalid Retail Rate",

                        text:
                            "Retail Rate must be greater than 0."
                    });


                    row.find(".retailRate").focus();

                    return;
                }


                // =================================================
                // Pharmacy Fields
                // =================================================

                detail.BatchNo =
                    batchNo;


                detail.ManufacturingDate =
                    mfgDate;


                detail.ExpiryDate =
                    expiryDate;


                detail.RetailRate =
                    retailRate;


                detail.SupplierDiscount =
                    supplierDiscount;


                detail.CostRate =
                    costRate;


                // Pharmacy Amount
                detail.Amount =
                    receivedQty *
                    costRate;
            }


            // ====================================================
            // Add Detail
            // ====================================================

            details.push(detail);

        });


        // ========================================================
        // Validation Failed
        // ========================================================

        if (validationFailed) {
            return;
        }


        // ========================================================
        // No Details
        // ========================================================

        if (details.length === 0) {

            Swal.fire({

                icon: "warning",

                title: "No Items",

                text:
                    "Please enter Received Quantity for at least one item."
            });

            return;
        }


        // ========================================================
        // Prepare Model
        // ========================================================

        var model = {

            GRNNumber:
                $("#GRNNumber").val(),

            GRNDate:
                $("#GRNDate").val(),

            PurchaseOrderId:
                parseInt(
                    $("#PurchaseOrderId").val()
                ),

            SupplierId:
                parseInt(
                    $("#SupplierId").val()
                ),

            BranchId:
                parseInt(
                    $("#BranchId").val()
                ),

            WarehouseId:
                parseInt(
                    $("#WarehouseId").val()
                ),

            TotalAmount:
                parseFloat(
                    $("#TotalAmount").text()
                ) || 0,

            Remarks:
                $("#Remarks").val(),

            CreatedBy:
                parseInt(
                    $("#CreatedBy").val()
                ),

            Details:
                details
        };


        // ========================================================
        // Console
        // ========================================================

        console.log("GRN Model:", model);

        console.log(
            "GRN JSON:",
            JSON.stringify(model)
        );


        // ========================================================
        // AJAX SAVE
        // ========================================================

        $.ajax({

            url:
                "/CreateGRN/SaveGRN",

            type:
                "POST",

            contentType:
                "application/json",

            data:
                JSON.stringify(model),


            beforeSend: function () {

                $("#btnSaveGRN")
                    .prop("disabled", true)
                    .html(
                        '<i class="fas fa-spinner fa-spin"></i> Saving...'
                    );
            },


            success: function (res) {

                if (res.success) {

                    Swal.fire({

                        icon:
                            "success",

                        title:
                            "Success",

                        text:
                            res.message

                    }).then(function () {

                        location.reload();

                    });

                }
                else {

                    Swal.fire({

                        icon:
                            "error",

                        title:
                            "Error",

                        text:
                            res.message
                    });
                }
            },


            error: function (xhr) {

                console.log(xhr);

                Swal.fire({

                    icon:
                        "error",

                    title:
                        "Error",

                    text:
                        xhr.responseText
                });
            },


            complete: function () {

                $("#btnSaveGRN")
                    .prop("disabled", false)
                    .html(
                        '<i class="fas fa-save"></i> Save GRN'
                    );
            }

        });

    });


</script>