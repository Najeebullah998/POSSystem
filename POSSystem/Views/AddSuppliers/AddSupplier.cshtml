@{
    ViewData["Title"] = "Suppliers";
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<div class="page-inner">

    <div class="row mb-1">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <div class="input-group ms-1">
                        <input type="text" class="form-control form-control-light" id="dash-daterange">
                        <span class="input-group-text bg-primary border-primary text-white">
                            <i class="mdi mdi-calendar-range font-13"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center flex-wrap p-1 pb-0 gap-2">

                    <div class="d-flex flex-wrap gap-2">
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">Go Back</a>
                    </div>

                    <div>
                        <a onclick="openAddModal()" class="btn btn-primary listbuttons">Create</a>
                    </div>

                </div>

                <div class="card-body">

                    <div class="dataTables_wrapper">

                        <table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">

                            <thead>
                                <tr>
                                    <th>Supplier Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody></tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Modal -->

<div class="modal fade" id="supplierModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Supplier</h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="supplierId" value="0" />

                <div class="mb-3">
                    <label class="form-label">Supplier Name</label>
                    <input type="text" class="form-control" id="supplierName">
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone">
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" id="email">
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsActive" checked>
                    <label class="form-check-label">Active</label>
                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary" onclick="saveSupplier()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>

<script>

    var supplierModal = new bootstrap.Modal(document.getElementById('supplierModal'));

    $(document).ready(function () {

        loadSuppliers();

    });

    function loadSuppliers() {

        $.ajax({

            url: '/AddSuppliers/GetAllSuppliers',
            type: 'GET',

            success: function (data) {

                var tbody = $("#datatable-buttons tbody");

                tbody.empty();

                $.each(data, function (i, supplier) {

                    var status = supplier.isActive ? "Active" : "Inactive";

                    tbody.append(`
                        <tr>
                            <td>${supplier.supplierName}</td>
                            <td>${supplier.phone}</td>
                            <td>${supplier.email}</td>
                            <td>${status}</td>
                            <td class="text-center">

                                <button class="btn btn-success btn-sm"
                                    onclick="editSupplier(${supplier.supplierId})">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm"
                                    onclick="deleteSupplier(${supplier.supplierId})">
                                    Delete
                                </button>

                            </td>
                        </tr>
                    `);

                });

            },

            error: function () {

                Swal.fire(
                    'Error',
                    'Failed to load suppliers.',
                    'error'
                );

            }

        });

    }

    function openAddModal() {

        $("#modalTitle").text("Add Supplier");

        $("#supplierId").val(0);
        $("#supplierName").val("");
        $("#phone").val("");
        $("#email").val("");
        $("#IsActive").prop("checked", true);

        supplierModal.show();

    }

    function saveSupplier() {

        var supplier = {

            SupplierId: $("#supplierId").val(),
            SupplierName: $("#supplierName").val(),
            Phone: $("#phone").val(),
            Email: $("#email").val(),
            IsActive: $("#IsActive").is(":checked")

        };

        var url = supplier.SupplierId == 0
            ? "/AddSuppliers/AddSupplier"
            : "/AddSuppliers/UpdateSupplier";

        $.ajax({

            url: url,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(supplier),

            success: function (response) {

                if (response.success) {

                    supplierModal.hide();

                    Swal.fire({

                        icon: "success",
                        title: "Success",
                        text: response.message,
                        timer: 1500,
                        showConfirmButton: false

                    }).then(function () {

                        loadSuppliers();

                    });

                }
                else {

                    Swal.fire("Error", response.message, "error");

                }

            },

            error: function () {

                Swal.fire("Error", "Something went wrong.", "error");

            }

        });

    }

    function editSupplier(id) {

        $.ajax({

            url: "/AddSuppliers/GetSupplierById?id=" + id,
            type: "GET",

            success: function (data) {

                $("#modalTitle").text("Edit Supplier");

                $("#supplierId").val(data.supplierId);
                $("#supplierName").val(data.supplierName);
                $("#phone").val(data.phone);
                $("#email").val(data.email);
                $("#IsActive").prop("checked", data.isActive);

                supplierModal.show();

            }

        });

    }

    function deleteSupplier(id) {

        Swal.fire({

            title: "Are you sure?",
            text: "This supplier will be deleted!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Delete"

        }).then(function (result) {

            if (result.isConfirmed) {

                $.ajax({

                    url: "/AddSuppliers/DeleteSupplier?id=" + id,
                    type: "POST",

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({

                                icon: "success",
                                title: "Deleted",
                                text: response.message,
                                timer: 1500,
                                showConfirmButton: false

                            });

                            loadSuppliers();

                        }

                    }

                });

            }

        });

    }

</script>