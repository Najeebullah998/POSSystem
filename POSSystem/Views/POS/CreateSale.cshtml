@model POSSystem.Entities.PosInvoiceVm
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<style>
    :root {
        --primary-color: #4361ee;
        --primary-dark: #3a56d4;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --dark-color: #1f2937;
        --light-bg: #f9fafb;
        --border-color: #e5e7eb;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding-bottom: 200px;
        min-height: 100vh;
    }

    .print-company-logo {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 50%;
        display: block;
        margin: 0 auto 5px auto;
    }

    /* Main Container */
    .pos-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Cards */
    .pos-card {
        background: white;
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .pos-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        }

    .card-header-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: 0.5px;
    }

    .card-header-success {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
    }

    .card-body-custom {
        padding: 25px;
    }

    /* Form Elements */
    .form-label-modern {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
    }

    .form-control-modern {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 12px;
        transition: all 0.3s;
        font-size: 14px;
    }

        .form-control-modern:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

    /* Search Section */
    .search-section {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    /* Table Styles */
    .table-wrapper {
        max-height: calc(100vh - 500px);
        overflow-y: auto;
        border-radius: 12px;
        background: white;
    }

    .pos-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .pos-table thead th {
            background: var(--dark-color);
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px;
            position: sticky;
            top: 0;
            z-index: 10;
            border: none;
        }

        .pos-table tbody tr {
            transition: all 0.2s;
            border-bottom: 1px solid var(--border-color);
        }

            .pos-table tbody tr:hover {
                background: #f8f9ff;
                transform: scale(1.01);
            }

        .pos-table tbody td {
            padding: 12px 15px;
            vertical-align: middle;
        }

    /* Quantity Controls */
    .qty-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .qty-minus {
        background: var(--warning-color);
        color: white;
    }

        .qty-minus:hover {
            background: #d97706;
            transform: scale(1.05);
        }

    .qty-plus {
        background: var(--success-color);
        color: white;
    }

        .qty-plus:hover {
            background: #059669;
            transform: scale(1.05);
        }

    .qty-value {
        font-weight: 600;
        min-width: 40px;
        text-align: center;
        font-size: 14px;
    }

    .delete-btn {
        background: var(--danger-color);
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        color: white;
        transition: all 0.2s;
    }

        .delete-btn:hover {
            background: #dc2626;
            transform: scale(1.05);
        }

    /* Payment Footer */
    .payment-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 3px solid var(--primary-color);
        box-shadow: 0 -5px 20px rgba(0,0,0,0.15);
        z-index: 1000;
        padding: 20px 30px;
    }

    .payment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        align-items: end;
    }

    .payment-card {
        background: var(--light-bg);
        padding: 15px;
        border-radius: 12px;
        transition: all 0.3s;
    }

        .payment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .payment-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .payment-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--dark-color);
        margin: 0;
    }

    .payment-input {
        font-size: 20px;
        font-weight: 600;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 8px 12px;
    }

    .save-btn {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3);
        }

    /* Print Styles */
    /* Print Styles */
    .print-area-hidden {
        display: none;
    }

  @@media print {

    @@page {
        size: 80mm auto;
        margin: 0;
    }

    html,
    body {
        width: 80mm;
        margin: 0;
        padding: 0;
    }

    body * {
        visibility: hidden;
    }

    #printArea,
    #printArea * {
        visibility: visible;
    }

    #printArea {
        position: absolute;
        left: 0;
        top: 0;

        width: 80mm;
        max-width: 80mm;

        padding: 4mm;
        margin: 0;

        box-sizing: border-box;

        background: white;

        font-size: 11px;
        line-height: 1.35;

        display: block !important;
    }

    /* Company Name */
    #printArea table:first-child td:first-child {
        font-size: 17px !important;
        font-weight: bold;
        padding-bottom: 3px;
    }

    /* Sales Invoice heading */
    #printArea table:first-child tr:nth-child(2) td {
        font-size: 12px !important;
        font-weight: bold;
        padding-bottom: 4px;
    }

    .thermal-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;

        font-size: 11px;
    }

    .thermal-table td,
    .thermal-table th {
        border: 1px dashed #000;
        padding: 4px 3px;
        vertical-align: middle;

        word-wrap: break-word;
    }

    /* Header information table */
    #printArea table:first-child td {
        border: none;
        padding: 2px 3px;
        font-size: 10px;
    }

    /* Items table columns */
    #printArea table:nth-child(2) th:nth-child(1),
    #printArea table:nth-child(2) td:nth-child(1) {
        width: 7%;
        text-align: center;
    }

    #printArea table:nth-child(2) th:nth-child(2),
    #printArea table:nth-child(2) td:nth-child(2) {
        width: 42%;
        text-align: left;
    }

    #printArea table:nth-child(2) th:nth-child(3),
    #printArea table:nth-child(2) td:nth-child(3) {
        width: 17%;
        text-align: right;
    }

    #printArea table:nth-child(2) th:nth-child(4),
    #printArea table:nth-child(2) td:nth-child(4) {
        width: 12%;
        text-align: center;
    }

    #printArea table:nth-child(2) th:nth-child(5),
    #printArea table:nth-child(2) td:nth-child(5) {
        width: 22%;
        text-align: right;
    }

    /* Table header */
    .thermal-table thead th {
        font-size: 10px;
        font-weight: bold;
        padding: 4px 2px;
    }

    /* Total / Discount / Net */
    .thermal-table tfoot td {
        font-size: 10px;
        padding: 4px 3px;
    }

    .thermal-table tfoot tr:last-child td {
        font-size: 12px;
        font-weight: bold;
        padding-top: 6px;
        padding-bottom: 6px;
    }

    #pNet {
        font-size: 13px !important;
        font-weight: bold;
    }

    .payment-footer {
        display: none !important;
    }

    .pos-container {
        display: none !important;
    }
}

    /* Animations */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .pos-table tbody tr {
        animation: slideIn 0.3s ease-out;
    }

    /* Badge */
    .stock-badge {
        background: #e5e7eb;
        color: var(--dark-color);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        margin-left: 8px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .payment-grid {
            grid-template-columns: 1fr;
        }

        .pos-container {
            padding: 10px;
        }

        .payment-footer {
            padding: 15px;
        }
    }
</style>

<input type="hidden" id="invoiceId" value="@ViewBag.InvoiceId" />
<input type="hidden" id="isEditMode" value="false" />
<div class="pos-container">
    <!-- Header Card -->
    <div class="pos-card">
        <div class="card-header-custom">
            <i class="fas fa-receipt"></i> Invoice Information
        </div>
        <div class="card-body-custom">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-hashtag"></i> Invoice No
                    </label>
                    <input type="text" id="invoiceNo" readonly class="form-control-modern" style="width: 100%;" placeholder="Auto-generated">
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="far fa-calendar-alt"></i> Date
                    </label>
                    <input type="date" id="invoiceDate" class="form-control-modern" style="width: 100%;" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-user"></i> Customer
                    </label>

                    <select asp-for="CustomerId" class="form-control" id="customerId">
                        @foreach (var customer in Model.Customerslist)
                        {
                            <option value="@customer.CustomerId">
                                @customer.CustomerName
                            </option>
                        }
                    </select>
                </div>
               @*  <div class="col-md-2">
                    <label hidden class="form-label-modern">
                        <i class="fas fa-store"></i> Branch
                    </label>
                    <input type="hidden" id="branchId" class="form-control-modern" style="width: 100%;" placeholder="Main Branch">
                </div> *@
                <div class="col-md-4">
                    <label class="form-label">Payment Mode</label>
                    <select id="paymentMode" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="EasyPaisa">EasyPaisa</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
               @*  <div class="col-md-3">
                    <label hidden class="form-label-modern">
                        <i class="fas fa-user-circle"></i> Cashier
                    </label>
                    <input type="hidden" id="userId" class="form-control-modern" style="width: 100%;" value="@HttpContextAccessor.HttpContext.Session.GetString("UserName")">
                </div> *@
            </div>
        </div>
    </div>

    <!-- POS Items Card -->
    <div class="pos-card">
        <div class="card-header-custom">
            <i class="fas fa-shopping-cart"></i> Point of Sale
        </div>
        <div class="card-body-custom">
            <!-- Search Section -->
            <div class="search-section">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label-modern" style="color: #92400e;">
                            <i class="fas fa-qrcode"></i> Scan Barcode
                        </label>
                        <input type="text" id="barcodeInput" class="form-control-modern" style="border-color: var(--warning-color);" placeholder="📱 Scan or type barcode...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-modern">Item Name</label>
                        <input type="text" id="itemName" class="form-control-modern" placeholder="Item will appear here" readonly style="background: #f3f4f6;">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-modern">Quantity</label>
                        <input type="number" id="qty" class="form-control-modern" value="1" min="1">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-modern">Price (Rs)</label>
                        <input type="text" id="price" class="form-control-modern" placeholder="0.00" readonly style="background: #f3f4f6;">
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-wrapper">
                <table class="pos-table" id="posTable">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="35%">Item Name</th>
                            <th width="15%">Rate (Rs)</th>
                            <th width="20%">Quantity</th>
                            <th width="15%">Amount (Rs)</th>
                            <th width="10%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-center">
                            <td colspan="6" style="padding: 60px 20px;">
                                <i class="fas fa-shopping-basket" style="font-size: 48px; color: #cbd5e1;"></i>
                                <p style="color: #94a3b8; margin-top: 15px;">No items added. Scan a product to begin!</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Payment Footer -->
<div class="payment-footer">
    <div class="payment-grid">
        <div class="payment-card">
            <div class="payment-label">Total Amount</div>
            <div class="payment-value">Rs <span id="totalDisplay">0.00</span></div>
            <input type="hidden" id="total" value="0">
        </div>

        <div class="payment-card">
            <div class="payment-label">Discount (%)</div>
            <input type="number" id="discount" class="payment-input" style="width: 100%;" value="0" step="0.01" min="0" max="100">
        </div>

        <div class="payment-card" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white;">
            <div class="payment-label" style="color: rgba(255,255,255,0.9);">Net Amount</div>
            <div class="payment-value" style="color: white;">Rs <span id="netAmount">0.00</span></div>
        </div>

        <div class="payment-card">
            <div class="payment-label">Amount Paid</div>
            <input type="number" id="paid" class="payment-input" style="width: 100%;" value="0" step="1">
        </div>

        <div class="payment-card">
            <div class="payment-label">Change Return</div>
            <div class="payment-value" style="color: var(--success-color);">Rs <span id="change">0.00</span></div>
        </div>

        <div>
            <button id="btnSave" class="save-btn">
                <i class="fas fa-save"></i> SAVE INVOICE
            </button>
        </div>
    </div>
</div>

<!-- Print Template -->
