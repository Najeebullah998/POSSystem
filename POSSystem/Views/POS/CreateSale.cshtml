                        </p>

                    </td>

                </tr>

            `);

        }

    }


    // =========================================================
    // CALCULATE TOTAL
    // =========================================================

    function calculateTotal() {

        let total = 0;


        $('#posTable tbody tr')
            .each(function () {

                if (
                    $(this)
                        .find('.qty-value')
                        .length === 0
                ) {
                    return;
                }


                const amount =
                    parseFloat(
                        $(this)
                            .find('.amount')
                            .text()
                    ) || 0;


                total += amount;

            });


        $('#total')
            .val(
                total.toFixed(2)
            );


        $('#totalDisplay')
            .text(
                total.toFixed(2)
            );


        calculateNet();

    }


    // =========================================================
    // DISCOUNT
    // =========================================================

    $('#discount').on(
        'keyup change',
        function () {

            calculateNet();

        }
    );


    function calculateNet() {

        let total =
            parseFloat(
                $('#total').val()
            ) || 0;


        // Treat discount input as percentage
        let discountPercent = parseFloat($('#discount').val()) || 0;

        if (discountPercent < 0) {
            discountPercent = 0;
            $('#discount').val(0);
        }

        if (discountPercent > 100) {
            discountPercent = 100;
            $('#discount').val(discountPercent);
        }

        const discountAmount = (total * discountPercent) / 100;

        const net = total - discountAmount;

        // Show discount amount in UI (if there's a cell for it)
        if ($('#pDiscount').length) {
            $('#pDiscount').text(discountAmount.toFixed(2));
        }

        $('#netAmount').text(net.toFixed(2));


        calculateChange();

    }


    // =========================================================
    // PAID AMOUNT
    // =========================================================

    $('#paid').on(
        'keyup change',
        function () {

            calculateChange();

        }
    );


    function calculateChange() {

        const net =
            parseFloat(
                $('#netAmount').text()
            ) || 0;


        const paid =
            parseFloat(
                $('#paid').val()
            ) || 0;


        let change =
            paid - net;


        if (change < 0) {
            change = 0;
        }


        $('#change')
            .text(
                change.toFixed(2)
            );

    }


    // =========================================================
    // RESET SEARCH FIELDS
    // =========================================================

    function resetFields() {

        selectedItem =
            null;


        $('#barcodeInput')
            .val('')
            .focus();


        $('#itemName')
            .val('');


        $('#qty')
            .val(1);


        $('#price')
            .val('');

    }


    // =========================================================
    // SAVE / UPDATE INVOICE
    // =========================================================

    $('#btnSave').click(
        function () {


            const items = [];


            $('#posTable tbody tr')
                .each(function () {

                    if (
                        $(this)
                            .find('.qty-value')
                            .length === 0
                    ) {
                        return;
                    }


                    const row =
                        $(this);


                    items.push({

    invoiceDetailId:
        parseInt(
            row.attr('data-invoice-detail-id')
        ) || 0,

    itemId:
        parseInt(
            row.data('id')
        ) || 0,

    rate:
        parseFloat(
            row.find('.rate').text()
        ) || 0,

    quantity:
        parseFloat(
            row.find('.qty-value').text()
        ) || 0,

    amount:
        parseFloat(
            row.find('.amount').text()
        ) || 0,

    batchNo:
        row.attr('data-batch-no') || null,

    manufacturingDate:
        row.attr('data-mfg-date') || null,

    expiryDate:
        row.attr('data-expiry-date') || null

});

                });


            // =================================================
            // VALIDATE CART
            // =================================================

            if (items.length === 0) {

                Swal.fire(
                    'Empty Cart',
                    'Please add items before saving.',
                    'warning'
                );

                return;
            }


            // =================================================
            // TOTALS
            // =================================================

            const totalAmount =
                parseFloat(
                    $('#total').val()
                ) || 0;


            const discount =
                parseFloat(
                    $('#discount').val()
                ) || 0;


            const netAmount =
                parseFloat(
                    $('#netAmount').text()
                ) || 0;


            const paidAmount =
                parseFloat(
                    $('#paid').val()
                ) || 0;


            const paymentMode =
                $('#paymentMode').val()
                || 'Cash';


            // =================================================
            // PAYMENT VALIDATION
            // =================================================

            if (paidAmount < netAmount) {

                Swal.fire(
                    'Insufficient Payment',
                    `Please collect Rs ${(netAmount - paidAmount).toFixed(2)} more.`,
                    'error'
                );

                return;
            }


            // =================================================
            // INVOICE ID
            // =================================================

            const invoiceId =
                parseInt(
                    $('#invoiceId').val()
                ) || 0;


            const isEdit =
                invoiceId > 0;


            // =================================================
            // MODEL
            // =================================================

            const model = {

                InvoiceId:
                    invoiceId,

                InvoiceNo:
                    $('#invoiceNo').val(),

                InvoiceDate:
                    $('#invoiceDate').val(),

                CustomerId:
                    parseInt(
                        $('#customerId').val()
                    ) || 0,

                TotalAmount:
                    totalAmount,

                Discount:
                    discount,

                NetAmount:
                    netAmount,

                PaymentMode:
                    paymentMode,

                PaidAmount:
                    paidAmount,

                Items:
                    items

            };


            console.log(
                isEdit
                    ? "UPDATE MODEL:"
                    : "SAVE MODEL:",
                model
            );


            // =================================================
            // CONFIRM
            // =================================================

            Swal.fire({

                title:
                    isEdit
                        ? 'Update Invoice?'
                        : 'Save Invoice?',

                text:
                    isEdit
                        ? 'The existing invoice will be updated.'
                        : 'This invoice will be saved.',

                icon:
                    'question',

                showCancelButton:
                    true,

                confirmButtonColor:
                    '#10b981',

                cancelButtonColor:
                    '#6c757d',

                confirmButtonText:
                    isEdit
                        ? 'Yes, Update'
                        : 'Yes, Save'

            })
            .then(function (result) {


                if (!result.isConfirmed) {
                    return;
                }


                Swal.fire({

                    title:
                        'Processing...',

                    text:
                        isEdit
                            ? 'Updating invoice...'
                            : 'Saving invoice...',

                    allowOutsideClick:
                        false,

                    didOpen:
                        function () {

                            Swal.showLoading();

                        }

                });


                // =================================================
                // AJAX SAVE / UPDATE
                // =================================================

                $.ajax({

                    url:
                        isEdit
                            ? '/POS/UpdateInvoice'
                            : '/POS/SaveInvoice',

                    type:
                        'POST',

                    contentType:
                        'application/json; charset=utf-8',

                    data:
                        JSON.stringify(model),


                    success:
                        function (res) {


                            console.log(
                                "Save/Update Response:",
                                res
                            );


                            if (res.success) {


                                preparePrint();


                                Swal.fire({

                                    icon:
                                        'success',

                                    title:
                                        isEdit
                                            ? 'Invoice Updated!'
                                            : 'Invoice Saved!',

                                    text:
                                        isEdit
                                            ? 'Invoice updated successfully.'
                                            : 'Invoice saved successfully.',

                                    confirmButtonColor:
                                        '#10b981'

                                })
                                .then(function () {


                                    setTimeout(
                                        function () {

                                            window.print();

                                        },
                                        500
                                    );

                                });

                            }

                            else {

                                Swal.fire(
                                    'Error',
                                    res.message ||
                                    'Operation failed.',
                                    'error'
                                );

                            }

                        },


                    error:
                        function (xhr) {


                            console.log(
                                "Save/Update Error:",
                                xhr.responseText
                            );


                            let message =
                                'An error occurred.';


                            try {

                                const response =
                                    JSON.parse(
                                        xhr.responseText
                                    );


                                if (response.message) {

                                    message =
                                        response.message;

                                }

                            }
                            catch (e) {

                                if (xhr.responseText) {

                                    message =
                                        xhr.responseText;

                                }

                            }


                            Swal.fire(
                                'Error',
                                message,
                                'error'
                            );

                        }

                });

            });

        }
    );


    // =========================================================
    // PRINT
    // =========================================================

    function preparePrint() {

        $('#pInvoiceNo')
            .text(
                $('#invoiceNo').val()
            );


        $('#pDate')
            .text(
                $('#invoiceDate').val()
            );


        $('#pTotal')
            .text(
                parseFloat(
                    $('#total').val()
                ).toFixed(2)
            );


        $('#pDiscount')
            .text(
                parseFloat(
                    $('#discount').val()
                ).toFixed(2)
            );


        $('#pNet')
            .text(
                $('#netAmount').text()
            );


        let rows = '';

        let index = 1;


        $('#posTable tbody tr')
            .each(function () {

                if (
                    $(this)
                        .find('.qty-value')
                        .length === 0
                ) {
                    return;
                }


                const item =
                    $(this)
                        .find('.item-name')
                        .text()
                        .trim();


                const rate =
                    parseFloat(
                        $(this)
                            .find('.rate')
                            .text()
                    ).toFixed(2);


                const qty =
                    $(this)
                        .find('.qty-value')
                        .text();


                const amount =
                    $(this)
                        .find('.amount')
                        .text();


                rows += `

                    <tr>

                        <td>
                            ${index++}
                        </td>

                        <td>
                            ${escapeHtml(item)}
                        </td>

                        <td style="text-align:right;">
                            ${rate}
                        </td>

                        <td style="text-align:center;">
                            ${qty}
                        </td>

                        <td style="text-align:right;">
                            ${amount}
                        </td>

                    </tr>

                `;

            });


        $('#printItems')
            .html(rows);


        $('#printArea')
            .show();

    }


    // =========================================================
    // AFTER PRINT
    // =========================================================

    window.onafterprint =
        function () {

            $('#printArea')
                .hide();

        };


    $(window).on(
        'focus',
        function () {

            $('#printArea')
                .hide();

        }
    );


    // =========================================================
    // ESCAPE HTML
    // =========================================================

    function escapeHtml(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return '';
        }


        return $('<div>')
            .text(value)
            .html();

    }

</script>