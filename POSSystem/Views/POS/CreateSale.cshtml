            </tr>

        </tfoot>

    </table>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>

<script>

    let rowIndex = 0;
    let selectedItem = null;
    let isSearching = false;


    // =========================================================
    // DOCUMENT READY
    // =========================================================

    $(document).ready(function () {

        console.log("POS Screen Loaded");

        const urlParams = new URLSearchParams(window.location.search);

        const invoiceId =
            parseInt(urlParams.get('invoiceId')) || 0;

        console.log("URL Invoice ID:", invoiceId);


        // =====================================================
        // EDIT EXISTING INVOICE
        // =====================================================

        if (invoiceId > 0) {

            console.log("EDIT MODE");

            $('#invoiceId').val(invoiceId);
            $('#isEditMode').val('true');

            loadBillForEdit(invoiceId);

        }

        // =====================================================
        // NEW SALE
        // =====================================================

        else {

            console.log("NEW SALE MODE");

            $('#invoiceId').val(0);
            $('#isEditMode').val('false');

            generateInvoiceNumber();

        }

    });


    // =========================================================
    // GENERATE NEW INVOICE NUMBER
    // =========================================================

    function generateInvoiceNumber() {

        $.ajax({

            url: '/POS/GenerateInvoiceNo',

            type: 'GET',

            success: function (response) {

                console.log(
                    "Generate Invoice Response:",
                    response
                );

                if (response && response.success) {

                    $('#invoiceNo')
                        .val(response.invoiceNo);

                }
                else {

                    Swal.fire(
                        'Error',
                        response.message ||
                        'Unable to generate invoice number.',
                        'error'
                    );

                }

            },

            error: function (xhr) {

                console.log(
                    "Generate Invoice Error:",
                    xhr.responseText
                );

                Swal.fire(
                    'Error',
                    'Unable to generate invoice number.',
                    'error'
                );

            }

        });

    }


    // =========================================================
    // LOAD EXISTING BILL FOR EDIT
    // =========================================================

    function loadBillForEdit(invoiceId) {

        if (!invoiceId || invoiceId <= 0) {

            Swal.fire(
                'Error',
                'Invalid Invoice ID.',
                'error'
            );

            return;
        }


        console.log(
            "Loading Invoice:",
            invoiceId
        );


        Swal.fire({

            title: 'Loading Bill...',

            text: 'Please wait',

            allowOutsideClick: false,

            didOpen: function () {

                Swal.showLoading();

            }

        });


        $.ajax({

            url: '/POS/GetBillById',

            type: 'GET',

            data: {
                invoiceId: invoiceId
            },


            success: function (res) {

                Swal.close();


                console.log(
                    "GetBillById Response:",
                    res
                );


                if (!res) {

                    Swal.fire(
                        'Error',
                        'Empty response received.',
                        'error'
                    );

                    return;
                }


                if (!res.success) {

                    Swal.fire(
                        'Error',
                        res.message ||
                        'Unable to load bill.',
                        'error'
                    );

                    return;
                }


                if (!res.invoice) {

                    Swal.fire(
                        'Error',
                        'Invoice data not found.',
                        'error'
                    );

                    return;
                }


                const invoice =
                    res.invoice;

                const details =
                    res.details || [];


                console.log(
                    "Invoice:",
                    invoice
                );

                console.log(
                    "Invoice Details:",
                    details
                );


                // =================================================
                // SET EDIT MODE
                // =================================================

                $('#invoiceId')
                    .val(invoice.invoiceId);

                $('#isEditMode')
                    .val('true');


                // =================================================
                // INVOICE NUMBER
                // =================================================

                $('#invoiceNo')
                    .val(invoice.invoiceNo || '');


                // =================================================
                // INVOICE DATE
                // =================================================

                if (invoice.invoiceDate) {

                    const date =
                        new Date(invoice.invoiceDate);


                    if (!isNaN(date.getTime())) {

                        const year =
                            date.getFullYear();

                        const month =
                            String(
                                date.getMonth() + 1
                            ).padStart(2, '0');

                        const day =
                            String(
                                date.getDate()
                            ).padStart(2, '0');


                        $('#invoiceDate').val(
                            `${year}-${month}-${day}`
                        );

                    }

                }


                // =================================================
                // CUSTOMER
                // =================================================

                $('#customerId')
                    .val(invoice.customerId || 0)
                    .trigger('change');


                // =================================================
                // PAYMENT MODE
                // =================================================

                $('#paymentMode')
                    .val(invoice.paymentMode || 'Cash')
                    .trigger('change');


                // =================================================
                // PAID AMOUNT
                // =================================================

                $('#paid').val(
                    parseFloat(
                        invoice.paidAmount || 0
                    ).toFixed(2)
                );


                // =================================================
                // DISCOUNT
                // =================================================

                $('#discount').val(
                    parseFloat(
                        invoice.discount || 0
                    ).toFixed(2)
                );


                // =================================================
                // CLEAR OLD TABLE
                // =================================================

                $('#posTable tbody').empty();

                rowIndex = 0;


                // =================================================
                // LOAD DETAILS
                // =================================================

                details.forEach(function (item) {

                    addExistingItemToTable(item);

                });


                // =================================================
                // EMPTY BILL
                // =================================================

                if (details.length === 0) {

                    $('#posTable tbody').html(`

                        <tr class="text-center">

                            <td colspan="6"
                                style="padding:60px 20px;">

                                <i class="fas fa-shopping-basket"
                                   style="
                                   font-size:48px;
                                   color:#cbd5e1;">
                                </i>

                                <p style="
                                   color:#94a3b8;
                                   margin-top:15px;">

                                   No items found.

                                </p>

                            </td>

                        </tr>

                    `);

                }


                // =================================================
                // RECALCULATE TOTALS
                // =================================================

                calculateTotal();

                // If invoice.discount was an absolute amount (older format),
                // convert it to percentage so the new percentage-based discount
                // input reflects the same discount relative to the total.
                try {
                    var totalVal = parseFloat($('#total').val()) || 0;
                    var invDisc = parseFloat(invoice.discount || 0) || 0;
                    if (invDisc > 0 && totalVal > 0) {
                        var percent = (invDisc / totalVal) * 100;
                        $('#discount').val(percent.toFixed(2));
                    }
                } catch (e) {
                    // ignore conversion errors
                }

                // Recalculate net after possibly updating discount input
                calculateNet();


                // =================================================
                // CHANGE SAVE BUTTON TO UPDATE
                // =================================================

                $('#btnSave')
                    .html(`
                        <i class="fas fa-edit"></i>
                        UPDATE INVOICE
                    `);


                // =================================================
                // FOCUS BARCODE
                // =================================================

                $('#barcodeInput')
                    .focus();


                console.log(
                    "Bill loaded successfully."
                );

            },


            error: function (xhr) {

                Swal.close();


                console.log(
                    "GetBillById Error:",
                    xhr.status,
                    xhr.responseText
                );


                let message =
                    'Unable to load bill.';


                try {

                    const response =
                        JSON.parse(
                            xhr.responseText
                        );

                    if (response.message) {

                        message =
                            response.message;

                    }

                }
                catch (e) {

                    if (xhr.responseText) {

                        message =
                            xhr.responseText;

                    }

                }


                Swal.fire(
                    'Error',
                    message,
                    'error'
                );

            }

        });

    }


    // =========================================================
    // ADD EXISTING ITEM FROM DATABASE
    // =========================================================

    function addExistingItemToTable(item) {

    rowIndex++;

    const itemId =
        parseInt(item.itemId) || 0;

    const itemName =
        item.itemName || 'Unknown';

    // =============================================
    // DATABASE QUANTITY
    // Example:
    // Quantity = 5
    // ReturnQty = 2
    // Effective Qty = 3
    // =============================================

    const databaseQuantity =
        parseFloat(item.quantity) || 0;

    const returnQty =
        parseFloat(item.returnQty) || 0;

    const quantity =
        Math.max(
            databaseQuantity - returnQty,
            0
        );

    const rate =
        parseFloat(item.rate) || 0;

    const amount =
        quantity * rate;

    const invoiceDetailId =
        parseInt(item.invoiceDetailId) || 0;


    // =============================================
    // PHARMACY BATCH
    // =============================================

    const batchNo =
        item.batchNo || '';

    const manufacturingDate =
        formatDateValue(
            item.manufacturingDate
        );

    const expiryDate =
        formatDateValue(
            item.expiryDate
        );


    const row = `

        <tr

            data-id="${itemId}"

            data-stock="999999"

            data-invoice-detail-id="${invoiceDetailId}"

            data-return-qty="${returnQty}"

            data-original-quantity="${databaseQuantity}"

            data-batch-no="${escapeHtml(batchNo)}"

            data-mfg-date="${manufacturingDate}"

            data-expiry-date="${expiryDate}"

        >

            <td>
                ${rowIndex}
            </td>

            <td class="item-name">
                ${escapeHtml(itemName)}
            </td>

            <td class="rate">
                ${rate.toFixed(2)}
            </td>

            <td>

                <div class="qty-controls">

                    <button
                        type="button"
                        class="qty-btn qty-minus"
                        onclick="updateQuantity(this, -1)">
                        -
                    </button>

                    <span class="qty-value">
                        ${quantity}
                    </span>

                    <button
                        type="button"
                        class="qty-btn qty-plus"
                        onclick="updateQuantity(this, 1)">
                        +
                    </button>

                </div>

            </td>

            <td class="amount">
                ${amount.toFixed(2)}
            </td>

            <td>

                <button
                    type="button"
                    class="delete-btn"
                    onclick="deleteRow(this)">

                    <i class="fas fa-trash"></i>

                </button>

            </td>

        </tr>

    `;

    $('#posTable tbody')
        .append(row);
}


    // =========================================================
    // FORMAT DATABASE DATE
    // =========================================================

    function formatDateValue(value) {

        if (!value) {
            return '';
        }


        const date =
            new Date(value);


        if (isNaN(date.getTime())) {
            return '';
        }


        const year =
            date.getFullYear();


        const month =
            String(
                date.getMonth() + 1
            ).padStart(2, '0');


        const day =
            String(
                date.getDate()
            ).padStart(2, '0');


        return `${year}-${month}-${day}`;

    }


    // =========================================================
    // BARCODE SEARCH
    // =========================================================

    $('#barcodeInput').on(
        'keydown',
        function (e) {

            if (e.key !== 'Enter') {
                return;
            }


            e.preventDefault();


            if (isSearching) {
                return;
            }


            const code =
                $.trim(
                    $(this).val()
                );


            if (code === '') {

                $(this).focus();

                return;
            }


            isSearching = true;


            $.ajax({

                url:
                    '/POS/GetItemByBarcode',

                type:
                    'GET',

                data: {
                    barcode: code
                },


                beforeSend:
                    function () {

                        $('#barcodeInput')
                            .prop(
                                'disabled',
                                true
                            );

                    },


                success:
                    function (res) {


                        console.log(
                            "Barcode Response:",
                            res
                        );


                        if (
                            !res ||
                            !res.itemId
                        ) {

                            Swal.fire(
                                'Not Found',
                                'Item not found.',
                                'error'
                            );

                            clearBarcode();

                            return;
                        }


                        if (
                            parseFloat(
                                res.stockQty
                            ) <= 0
                        ) {

                            Swal.fire(
                                'Out of Stock',
                                'This item is out of stock.',
                                'warning'
                            );

                            clearBarcode();

                            return;
                        }


                        selectedItem =
                            res;


                        $('#itemName')
                            .val(
                                res.itemName
                            );


                        $('#price').val(
                            parseFloat(
                                res.rate || 0
                            ).toFixed(2)
                        );


                        $('#qty')
                            .val(1);


                        calculateAmount();


                        $('#barcodeInput')
                            .val('');


                        $('#qty')
                            .focus()
                            .select();

                    },


                error:
                    function (xhr) {


                        console.log(
                            "Barcode Error:",
                            xhr.responseText
                        );


                        Swal.fire(
                            'Error',
                            'Unable to retrieve item.',
                            'error'
                        );


                        clearBarcode();

                    },


                complete:
                    function () {

                        isSearching =
                            false;


                        $('#barcodeInput')
                            .prop(
                                'disabled',
                                false
                            );

                    }

            });

        }
    );


