@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<style>
    :root {
        --primary-color: #4361ee;
        --primary-dark: #3a56d4;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --dark-color: #1f2937;
        --light-bg: #f9fafb;
        --border-color: #e5e7eb;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding-bottom: 200px;
        min-height: 100vh;
    }

    /* Main Container */
    .pos-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Cards */
    .pos-card {
        background: white;
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .pos-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        }

    .card-header-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: 0.5px;
    }

    .card-header-success {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
    }

    .card-body-custom {
        padding: 25px;
    }

    /* Form Elements */
    .form-label-modern {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
    }

    .form-control-modern {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 12px;
        transition: all 0.3s;
        font-size: 14px;
    }

        .form-control-modern:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

    /* Search Section */
    .search-section {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    /* Table Styles */
    .table-wrapper {
        max-height: calc(100vh - 500px);
        overflow-y: auto;
        border-radius: 12px;
        background: white;
    }

    .pos-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .pos-table thead th {
            background: var(--dark-color);
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px;
            position: sticky;
            top: 0;
            z-index: 10;
            border: none;
        }

        .pos-table tbody tr {
            transition: all 0.2s;
            border-bottom: 1px solid var(--border-color);
        }

            .pos-table tbody tr:hover {
                background: #f8f9ff;
                transform: scale(1.01);
            }

        .pos-table tbody td {
            padding: 12px 15px;
            vertical-align: middle;
        }

    /* Quantity Controls */
    .qty-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .qty-minus {
        background: var(--warning-color);
        color: white;
    }

        .qty-minus:hover {
            background: #d97706;
            transform: scale(1.05);
        }

    .qty-plus {
        background: var(--success-color);
        color: white;
    }

        .qty-plus:hover {
            background: #059669;
            transform: scale(1.05);
        }

    .qty-value {
        font-weight: 600;
        min-width: 40px;
        text-align: center;
        font-size: 14px;
    }

    .delete-btn {
        background: var(--danger-color);
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        color: white;
        transition: all 0.2s;
    }

        .delete-btn:hover {
            background: #dc2626;
            transform: scale(1.05);
        }

    /* Payment Footer */
    .payment-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 3px solid var(--primary-color);
        box-shadow: 0 -5px 20px rgba(0,0,0,0.15);
        z-index: 1000;
        padding: 20px 30px;
    }

    .payment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        align-items: end;
    }

    .payment-card {
        background: var(--light-bg);
        padding: 15px;
        border-radius: 12px;
        transition: all 0.3s;
    }

        .payment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .payment-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .payment-value {
        font-size: 24px;
        font-weight: 700;
        color: var(--dark-color);
        margin: 0;
    }

    .payment-input {
        font-size: 20px;
        font-weight: 600;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 8px 12px;
    }

    .save-btn {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.3);
        }

    /* Print Styles */
    /* Print Styles */
    .print-area-hidden {
        display: none;
    }

    @@media print {
        body * {
            visibility: hidden;
        }
        .print-area-hidden {
            display: block !important;
        }

        #printArea, #printArea * {
            visibility: visible;
        }

        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 80mm;
            background: white;
            padding: 10px;
            display: block !important; /* Override the display:none */
        }

        .thermal-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
        }

            .thermal-table td, .thermal-table th {
                border: 1px dashed #000;
                padding: 4px;
            }
        /* Hide payment footer and other elements during print */
        .payment-footer {
            display: none !important;
        }

        .pos-container {
            display: none !important;
        }
    }

    /* Animations */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .pos-table tbody tr {
        animation: slideIn 0.3s ease-out;
    }

    /* Badge */
    .stock-badge {
        background: #e5e7eb;
        color: var(--dark-color);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        margin-left: 8px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .payment-grid {
            grid-template-columns: 1fr;
        }

        .pos-container {
            padding: 10px;
        }

        .payment-footer {
            padding: 15px;
        }
    }
</style>

<input type="hidden" id="invoiceId" value="@ViewBag.InvoiceId" />
<input type="hidden" id="isEditMode" value="true" />
<div class="pos-container">
    <!-- Header Card -->
    <div class="pos-card">
        <div class="card-header-custom">
            <i class="fas fa-receipt"></i> Invoice Information
        </div>
        <div class="card-body-custom">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-hashtag"></i> Invoice No
                    </label>
                    <input type="text" id="invoiceNo" readonly class="form-control-modern" style="width: 100%;" placeholder="Auto-generated">
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="far fa-calendar-alt"></i> Date
                    </label>
                    <input type="date" id="invoiceDate" class="form-control-modern" style="width: 100%;" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-user"></i> Customer
                    </label>
                    <select id="customerId" class="form-control-modern" style="width: 100%;">
                        <option value="1">👤 Walk-in Customer</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-store"></i> Branch
                    </label>
                    <input type="text" id="branchId" class="form-control-modern" style="width: 100%;" placeholder="Main Branch">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Mode</label>
                    <select id="paymentMode" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="EasyPaisa">EasyPaisa</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-user-circle"></i> Cashier
                    </label>
                    <input type="text" id="userId" class="form-control-modern" style="width: 100%;" value="@HttpContextAccessor.HttpContext.Session.GetString("UserName")">
                </div>
            </div>
        </div>
    </div>

    <!-- POS Items Card -->
    <div class="pos-card">
        <div class="card-header-custom">
            <i class="fas fa-shopping-cart"></i> Point of Sale
        </div>
        <div class="card-body-custom">
            <!-- Search Section -->
            <div class="search-section">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label-modern" style="color: #92400e;">
                            <i class="fas fa-qrcode"></i> Scan Barcode
                        </label>
                        <input type="text" id="barcodeInput" class="form-control-modern" style="border-color: var(--warning-color);" placeholder="📱 Scan or type barcode...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-modern">Item Name</label>
                        <input type="text" id="itemName" class="form-control-modern" placeholder="Item will appear here" readonly style="background: #f3f4f6;">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-modern">Quantity</label>
                        <input type="number" id="qty" class="form-control-modern" value="1" min="1">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-modern">Price (Rs)</label>
                        <input type="text" id="price" class="form-control-modern" placeholder="0.00" readonly style="background: #f3f4f6;">
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-wrapper">
                <table class="pos-table" id="posTable">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="35%">Item Name</th>
                            <th width="15%">Rate (Rs)</th>
                            <th width="20%">Quantity</th>
                            <th width="15%">Amount (Rs)</th>
                            <th width="10%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-center">
                            <td colspan="6" style="padding: 60px 20px;">
                                <i class="fas fa-shopping-basket" style="font-size: 48px; color: #cbd5e1;"></i>
                                <p style="color: #94a3b8; margin-top: 15px;">No items added. Scan a product to begin!</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Payment Footer -->
<div class="payment-footer">
    <div class="payment-grid">
        <div class="payment-card">
            <div class="payment-label">Total Amount</div>
            <div class="payment-value">Rs <span id="totalDisplay">0.00</span></div>
            <input type="hidden" id="total" value="0">
        </div>

        <div class="payment-card">
            <div class="payment-label">Discount (Rs)</div>
            <input type="number" id="discount" class="payment-input" style="width: 100%;" value="0" step="1">
        </div>

        <div class="payment-card" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white;">
            <div class="payment-label" style="color: rgba(255,255,255,0.9);">Net Amount</div>
            <div class="payment-value" style="color: white;">Rs <span id="netAmount">0.00</span></div>
        </div>

        <div class="payment-card">
            <div class="payment-label">Amount Paid</div>
            <input type="number" id="paid" class="payment-input" style="width: 100%;" value="0" step="1">
        </div>

        <div class="payment-card">
            <div class="payment-label">Change Return</div>
            <div class="payment-value" style="color: var(--success-color);">Rs <span id="change">0.00</span></div>
        </div>

        <div>
            <button id="btnSave" class="save-btn">
                <i class="fas fa-save"></i> SAVE INVOICE
            </button>
        </div>
    </div>
</div>

<!-- Print Template -->
<div id="printArea" class="print-area-hidden">
    <table class="thermal-table">
        <tr>
            <td colspan="4" style="text-align: center; font-size: 16px; font-weight: bold;">@HttpContextAccessor.HttpContext.Session.GetString("CompanyName")</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">SALES INVOICE</td>
        </tr>
        <tr>
            <td colspan="2">Cashier:</td>
            <td colspan="2">@HttpContextAccessor.HttpContext.Session.GetString("UserName")</td>
        </tr>
        <tr>
            <td colspan="2">Invoice #:</td>
            <td colspan="2" id="pInvoiceNo"></td>
        </tr>
        <tr>
            <td colspan="2">Date:</td>
            <td colspan="2" id="pDate"></td>
        </tr>
        <tr>
            <td colspan="4" style="height: 5px;"></td>
        </tr>
    </table>

    <table class="thermal-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Item</th>
                <th>Rate</th>
                <th>Qty</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody id="printItems"></tbody>
        <tfoot>
            <tr>
                <td colspan="4"><strong>Total</strong></td>
                <td id="pTotal"></td>
            </tr>
            <tr>
                <td colspan="4"><strong>Discount</strong></td>
                <td id="pDiscount"></td>
            </tr>
            <tr>
                <td colspan="4"><strong>NET TOTAL</strong></td>
                <td><strong id="pNet"></strong></td>
            </tr>
        </tfoot>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>

<script>
    let rowIndex = 0;
    let selectedItem = null;

   

    // Search/Scan barcode
    let isSearching = false;


 $(document).ready(function () {

    $.get('/POS/GenerateInvoiceNo', function (response) {

        if (response.success) {
            $('#invoiceNo').val(response.invoiceNo);
        } else {
            console.log(response.message);
        }

    });

});
    //===============================
    // Barcode Scan
    //===============================
    $('#barcodeInput').on('keydown', function(e) {

        if (e.key !== 'Enter')
            return;

        e.preventDefault();

        if (isSearching)
            return;

        let code = $.trim($(this).val());

        if (code === '') {
            $(this).focus();
            return;
        }

        isSearching = true;

        $.ajax({
            url: '/POS/GetItemByBarcode',
            type: 'GET',
            data: { barcode: code },

            beforeSend: function() {
                $('#barcodeInput').prop('disabled', true);
            },

            success: function(res) {

                // Item not found
                if (!res || !res.itemId) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Not Found',
                        text: 'Item not found.'
                    });

                    clearBarcode();
                    return;
                }

                // Out of Stock
                if (parseFloat(res.stockQty) <= 0) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Out of Stock',
                        text: 'This item is out of stock.'
                    });

                    clearBarcode();
                    return;
                }

                // Store Selected Item
                selectedItem = res;

                // Fill Controls
                $('#itemName').val(res.itemName);
                $('#price').val(parseFloat(res.salePrice).toFixed(2));
                $('#qty').val(1);

                calculateAmount();

                // Clear Barcode & Focus Qty
                $('#barcodeInput').val('');
                $('#qty').focus().select();
            },

            error: function() {

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to retrieve item.'
                });

                clearBarcode();
            },

            complete: function() {

                isSearching = false;
                $('#barcodeInput').prop('disabled', false);

            }
        });

    });

    //===============================
    // Clear Barcode Controls
    //===============================
    function clearBarcode() {

        selectedItem = null;

        $('#barcodeInput')
            .val('')
            .prop('disabled', false)
            .focus();

        $('#itemName').val('');
        $('#price').val('');
        $('#qty').val(1);
        $('#amount').val('');
    }

    // Calculate amount
    $('#qty').on('keyup change', function() {
        calculateAmount();
    });

    function calculateAmount() {
        let qty = parseFloat($('#qty').val()) || 0;
        let price = parseFloat($('#price').val()) || 0;
        $('#amount').val((qty * price).toFixed(2));
    }

    // Add item on Enter
    $('#qty').on('keypress', function(e) {
        if (e.which === 13) {
            addItemToTable();
        }
    });

    function addItemToTable() {
        if (!selectedItem) return;

        let itemId = selectedItem.itemId;
        let itemName = selectedItem.itemName;
        let qty = parseFloat($('#qty').val()) || 0;
        let rate = parseFloat($('#price').val()) || 0;
        let stockQty = parseFloat(selectedItem.stockQty) || 0;

        if (qty <= 0) {
            Swal.fire('Invalid', 'Quantity must be greater than 0', 'warning');
            return;
        }

        if (qty > stockQty) {
            Swal.fire('Stock Limit', `Only ${stockQty} items available!`, 'warning');
            $('#qty').val(stockQty);
            return;
        }

        let found = false;

        $('#posTable tbody tr').each(function() {
            let rowItemId = $(this).data('id');
            if (rowItemId == itemId) {
                let rowRate = parseFloat($(this).find('.rate').text());
                let oldQty = parseFloat($(this).find('.qty-value').text());
                let newQty = oldQty + qty;

                if (newQty > stockQty) {
                    Swal.fire('Stock Limit', `Cannot add more than ${stockQty} items!`, 'warning');
                    return;
                }

                $(this).find('.qty-value').text(newQty);
                $(this).find('.amount').text((newQty * rowRate).toFixed(2));
                found = true;
            }
        });

        if (!found) {
            // Remove empty message
            if ($('#posTable tbody tr').length === 1 && $('#posTable tbody tr td').attr('colspan')) {
                $('#posTable tbody').empty();
            }

            rowIndex++;
            let row = `
                    <tr data-id="${itemId}" data-stock="${stockQty}">
                    <td>${rowIndex}</td>
                    <td class="item-name">${itemName}</td>
                    <td class="rate">${rate.toFixed(2)}</td>
                    <td>
                        <div class="qty-controls">
                            <button class="qty-btn qty-minus" onclick="updateQuantity(this, -1)">-</button>
                            <span class="qty-value">${qty}</span>
                            <button class="qty-btn qty-plus" onclick="updateQuantity(this, 1)">+</button>
                        </div>
                    </td>
                    <td class="amount">${(qty * rate).toFixed(2)}</td>
                    <td>
                        <button class="delete-btn" onclick="deleteRow(this)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            $('#posTable tbody').append(row);
        }

        calculateTotal();
        resetFields();
    }

    // Update quantity
    window.updateQuantity = function(btn, delta) {

        let row = $(btn).closest('tr');

        let qtySpan = row.find('.qty-value');

        let currentQty = parseFloat(qtySpan.text());

        let stockQty = parseFloat(row.data('stock'));

        let newQty = currentQty + delta;

        let rate = parseFloat(row.find('.rate').text());

        // Minus button
        if (newQty <= 0) {
            deleteRow(btn);
            return;
        }

        // Stock Validation
        if (newQty > stockQty) {
            Swal.fire({
                icon: 'warning',
                title: 'Stock Limit',
                text: `Only ${stockQty} item(s) available in stock.`
            });
            return;
        }

        qtySpan.text(newQty);

        row.find('.amount').text((newQty * rate).toFixed(2));

        calculateTotal();
    };

    // Delete row
    window.deleteRow = function(btn) {

        const row = $(btn).closest('tr');

        // Current invoice ID
        const invoiceId = parseInt($('#invoiceId').val()) || 0;

        // Detail ID jo loadBillForEdit() mein data attribute mein rakhi hai
        const invoiceDetailId =
            parseInt(row.attr('data-invoice-detail-id')) || 0;

        const itemName = row.find('.item-name').text().trim();
        const quantity = parseFloat(row.find('.qty-value').text()) || 0;

        // ==============================
        // EDIT MODE + EXISTING DETAIL
        // ==============================

        if (invoiceId > 0 && invoiceDetailId > 0) {

            Swal.fire({
                title: 'Return Item?',
                html: `
                    <b>${itemName}</b><br>
                    Quantity: <b>${quantity}</b><br><br>
                    This item will be removed from the invoice
                    and stock will be returned.
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Return Item'
            }).then((result) => {

                if (!result.isConfirmed)
                    return;

                Swal.fire({
                    title: 'Processing...',
                    text: 'Returning item to stock',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/POS/DeleteBill',
                    type: 'POST',
                    data: {
                        invoiceId: invoiceId,
                        invoiceDetailId: invoiceDetailId
                    },

                    success: function(res) {

                        if (res.success) {

                            // Remove row from UI
                            row.remove();

                            // Renumber rows
                            $('#posTable tbody tr').each(function(index) {
                                $(this).find('td:first').text(index + 1);
                            });

                            calculateTotal();

                            // Empty cart message
                            if ($('#posTable tbody tr').length === 0) {

                                $('#posTable tbody').html(`
                                    <tr class="text-center">
                                        <td colspan="6" style="padding: 60px 20px;">
                                            <i class="fas fa-shopping-basket"
                                               style="font-size: 48px; color: #cbd5e1;">
                                            </i>

                                            <p style="color: #94a3b8; margin-top: 15px;">
                                                No items added. Scan a product to begin!
                                            </p>
                                        </td>
                                    </tr>
                                `);
                            }

                            Swal.fire({
                                icon: 'success',
                                title: 'Item Returned',
                                text: res.message || 'Item removed and stock returned.',
                                confirmButtonColor: '#10b981'
                            });

                        } else {

                            Swal.fire(
                                'Error',
                                res.message || 'Unable to remove item.',
                                'error'
                            );
                        }
                    },

                    error: function(xhr) {

                        console.log(
                            'Delete Item Error:',
                            xhr.responseText
                        );

                        Swal.fire(
                            'Error',
                            'Unable to return item to stock.',
                            'error'
                        );
                    }
                });

            });

            return;
        }

        // ==============================
        // NEW ITEM / NOT SAVED IN DB
        // ==============================

        Swal.fire({
            title: 'Remove Item?',
            text: 'This item will be removed from cart.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, remove!'
        }).then((result) => {

            if (result.isConfirmed) {

                row.remove();

                $('#posTable tbody tr').each(function(index) {
                    $(this).find('td:first').text(index + 1);
                });

                calculateTotal();

                if ($('#posTable tbody tr').length === 0) {

                    $('#posTable tbody').html(`
                        <tr class="text-center">
                            <td colspan="6" style="padding: 60px 20px;">
                                <i class="fas fa-shopping-basket"
                                   style="font-size: 48px; color: #cbd5e1;">
                                </i>

                                <p style="color: #94a3b8; margin-top: 15px;">
                                    No items added. Scan a product to begin!
                                </p>
                            </td>
                        </tr>
                    `);
                }
            }
        });
    };

    // Calculate totals
    function calculateTotal() {
        let total = 0;

        $('#posTable tbody tr').each(function() {
            let amount = parseFloat($(this).find('.amount').text()) || 0;
            total += amount;
        });

        $('#total').val(total.toFixed(2));
        $('#totalDisplay').text(total.toFixed(2));
        calculateNet();
    }

    $('#discount').on('keyup change', function() {
        calculateNet();
    });

    function calculateNet() {
        let total = parseFloat($('#total').val()) || 0;
        let discount = parseFloat($('#discount').val()) || 0;

        if (discount > total) {
            discount = total;
            $('#discount').val(discount);
        }

        let net = total - discount;
        $('#netAmount').text(net.toFixed(2));
        calculateChange();
    }

    $('#paid').on('keyup change', function() {
        calculateChange();
    });

    function calculateChange() {
        let net = parseFloat($('#netAmount').text()) || 0;
        let paid = parseFloat($('#paid').val()) || 0;
        let change = paid - net;

        if (change < 0) change = 0;
        $('#change').text(change.toFixed(2));
    }

    function resetFields() {
        selectedItem = null;
        $('#barcodeInput').val('').focus();
        $('#itemName').val('');
        $('#qty').val(1);
        $('#price').val('');
    }

    // Save invoice
    $('#btnSave').click(function() {

        let items = [];

        $('#posTable tbody tr').each(function() {

            // Empty message row skip
            if ($(this).find('.qty-value').length === 0)
                return;

            items.push({
                itemId: $(this).data('id'),
                rate: parseFloat($(this).find('.rate').text()) || 0,
                quantity: parseFloat($(this).find('.qty-value').text()) || 0,
                amount: parseFloat($(this).find('.amount').text()) || 0
            });
        });

        if (items.length === 0) {
            Swal.fire(
                'Empty Cart',
                'Please add items before saving!',
                'warning'
            );
            return;
        }

        let netAmount = parseFloat($('#netAmount').text()) || 0;
        let paid = parseFloat($('#paid').val()) || 0;

        if (paid < netAmount) {
            Swal.fire(
                'Insufficient Payment',
                `Please collect Rs${(netAmount - paid).toFixed(2)} more`,
                'error'
            );
            return;
        }

        // Get InvoiceId
        let invoiceId = parseInt($('#invoiceId').val()) || 0;

        // Model
        let model = {
            InvoiceId: invoiceId,
            InvoiceNo: $('#invoiceNo').val(),
            InvoiceDate: $('#invoiceDate').val(),
            CustomerId: parseInt($('#customerId').val()) || 0,
            BranchId: parseInt($('#branchId').val()) || 0,
            UserId: parseInt($('#userId').val()) || 0,
            TotalAmount: parseFloat($('#total').val()) || 0,
            Discount: parseFloat($('#discount').val()) || 0,
            NetAmount: netAmount,
            PaymentMode: $('#paymentMode').val(),
            Items: items
        };

        // Edit or New
        let isEdit = invoiceId > 0;

        Swal.fire({
            title: 'Processing...',
            text: isEdit
                ? 'Updating invoice...'
                : 'Saving invoice...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({

            url: isEdit
                ? '/POS/UpdateInvoice'
                : '/POS/SaveInvoice',

            type: 'POST',

            contentType: 'application/json',

            data: JSON.stringify(model),

            success: function(res) {

                if (res.success) {

                    preparePrint();

                    Swal.fire({
                        icon: 'success',
                        title: isEdit
                            ? 'Updated!'
                            : 'Success!',
                        text: isEdit
                            ? 'Invoice updated successfully!'
                            : 'Invoice saved successfully!',
                        confirmButtonColor: '#10b981'
                    }).then(() => {

                        setTimeout(function() {
                            window.print();
                        }, 500);

                    });

                } else {

                    Swal.fire(
                        'Error',
                        res.message ||
                        (isEdit
                            ? 'Failed to update invoice'
                            : 'Failed to save invoice'),
                        'error'
                    );
                }
            },

            error: function(xhr) {

                console.log("Update/Save Error:", xhr.responseText);

                Swal.fire(
                    'Error',
                    xhr.responseText ||
                    (isEdit
                        ? 'An error occurred while updating'
                        : 'An error occurred while saving'),
                    'error'
                );
            }
        });
    });

        function preparePrint() {
        $('#pInvoiceNo').text($('#invoiceNo').val());
        $('#pDate').text($('#invoiceDate').val());
        $('#pTotal').text(parseFloat($('#total').val()).toFixed(2));
        $('#pDiscount').text(parseFloat($('#discount').val()).toFixed(2));
        $('#pNet').text($('#netAmount').text());

        let rows = '';
        let index = 1;

        $('#posTable tbody tr').each(function() {
            let item = $(this).find('.item-name').text();
            let rate = parseFloat($(this).find('.rate').text()).toFixed(2);
            let qty = $(this).find('.qty-value').text();
            let amount = $(this).find('.amount').text();

            rows += `
                <tr>
                    <td>${index++}</td>
                    <td>${item}</td>
                    <td style="text-align:right;">${rate}</td>
                    <td style="text-align:center;">${qty}</td>
                    <td style="text-align:right;">${amount}</td>
                </tr>
            `;
        });

        $('#printItems').html(rows);

        // Make print area visible for printing
        $('#printArea').show();
    }

        // After printing, hide the print area again
       // Hide print area after printing
    window.onafterprint = function() {
        $('#printArea').hide();
    };

    // Also hide on window focus after print dialog closes
    $(window).on('focus', function() {
        $('#printArea').hide();
    });

   function loadBillForEdit(invoiceId) {

    Swal.fire({
        title: 'Loading Bill...',
        text: 'Please wait',
        allowOutsideClick: false,
        didOpen: function () {
            Swal.showLoading();
        }
    });

    $.ajax({
        url: '/POS/GetBillById',
        type: 'GET',
        data: {
            invoiceId: invoiceId
        },

        success: function (res) {

            Swal.close();

            console.log("Edit Bill Response:", res);

            if (!res.success || !res.invoice) {

                Swal.fire(
                    'Error',
                    res.message || 'Bill not found.',
                    'error'
                );

                return;
            }

            // ==================================
            // HEADER
            // ==================================

            const invoice = res.invoice;
            const details = res.details || [];

            $('#invoiceId').val(invoice.invoiceId);

            $('#invoiceNo').val(invoice.invoiceNo || '');

            if (invoice.invoiceDate) {

                const date = new Date(invoice.invoiceDate);

                $('#invoiceDate').val(
                    date.toISOString().split('T')[0]
                );
            }

            // Customer
            if (invoice.customerId) {

                $('#customerId')
                    .val(invoice.customerId)
                    .trigger('change');
            }

            // Branch
            $('#branchId').val(invoice.branchId || '');

            // Discount
            $('#discount').val(
                parseFloat(invoice.discount || 0).toFixed(2)
            );


            // ==================================
            // CLEAR EXISTING POS ITEMS
            // ==================================

            $('#posTable tbody').empty();

            rowIndex = 0;


            // ==================================
            // LOAD ITEMS
            // ==================================

            details.forEach(function (item) {

                rowIndex++;

                const quantity =
                    parseFloat(item.quantity || 0);

                const rate =
                    parseFloat(item.rate || 0);

                const amount =
                    parseFloat(item.amount || 0);

                let row = `
                    <tr data-id="${item.itemId}"
                        data-stock="999999"
                        data-invoice-detail-id="${item.invoiceDetailId || 0}"
                        data-batch-no="${item.batchNo || ''}"
                        data-mfg-date="${item.manufacturingDate || ''}"
                        data-expiry-date="${item.expiryDate || ''}">

                        <td>${rowIndex}</td>

                        <td class="item-name">
                            ${item.itemName || 'Unknown'}
                        </td>

                        <td class="rate">
                            ${rate.toFixed(2)}
                        </td>

                        <td>
                            <div class="qty-controls">

                                <button
                                    class="qty-btn qty-minus"
                                    onclick="updateQuantity(this, -1)">
                                    -
                                </button>

                                <span class="qty-value">
                                    ${quantity}
                                </span>

                                <button
                                    class="qty-btn qty-plus"
                                    onclick="updateQuantity(this, 1)">
                                    +
                                </button>

                            </div>
                        </td>

                        <td class="amount">
                            ${amount.toFixed(2)}
                        </td>

                        <td>
                            <button
                                class="delete-btn"
                                onclick="deleteRow(this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>

                    </tr>
                `;

                $('#posTable tbody').append(row);
            });


            // ==================================
            // EMPTY BILL CHECK
            // ==================================

            if (details.length === 0) {

                $('#posTable tbody').html(`
                    <tr class="text-center">
                        <td colspan="6"
                            style="padding: 60px 20px;">

                            <i class="fas fa-shopping-basket"
                               style="font-size:48px;color:#cbd5e1;">
                            </i>

                            <p style="color:#94a3b8;margin-top:15px;">
                                No items found.
                            </p>

                        </td>
                    </tr>
                `);
            }


            // ==================================
            // CALCULATE TOTALS
            // ==================================

            calculateTotal();


            // ==================================
            // CHANGE BUTTON TO UPDATE
            // ==================================

            $('#btnSave').html(`
                <i class="fas fa-save"></i>
                Update Invoice
            `);

            $('#btnSave').data('edit-mode', true);


            // ==================================
            // FOCUS
            // ==================================

            $('#barcodeInput').focus();


            console.log("Bill loaded successfully.");

        },

        error: function (xhr) {

            Swal.close();

            console.log(
                "GetBillById Error:",
                xhr.responseText
            );

            Swal.fire(
                'Error',
                'Unable to load bill.',
                'error'
            );
        }
    });
}

</script>