    // =========================================================
    // ADD NEW ITEM
    // =========================================================

    function addItemToTable() {

        if (!selectedItem) {

            Swal.fire(
                'Select Item',
                'Please scan/select an item first.',
                'warning'
            );

            return;
        }


        const itemId =
            parseInt(
                selectedItem.itemId
            ) || 0;


        const itemName =
            selectedItem.itemName || '';


        const qty =
            parseFloat(
                $('#qty').val()
            ) || 0;


        const rate =
            parseFloat(
                $('#price').val()
            ) || 0;


        const stockQty =
            parseFloat(
                selectedItem.stockQty
            ) || 0;


        // =====================================================
        // PHARMACY BATCH
        // =====================================================

        const batchNo =
            selectedItem.batchNo || '';


        const manufacturingDate =
            formatDateValue(
                selectedItem.manufacturingDate
            );


        const expiryDate =
            formatDateValue(
                selectedItem.expiryDate
            );


        // =====================================================
        // VALIDATION
        // =====================================================

        if (qty <= 0) {

            Swal.fire(
                'Invalid',
                'Quantity must be greater than 0.',
                'warning'
            );

            return;
        }


        if (qty > stockQty) {

            Swal.fire(
                'Stock Limit',
                `Only ${stockQty} item(s) available.`,
                'warning'
            );

            $('#qty')
                .val(stockQty);

            return;
        }


        let found = false;


        // =====================================================
        // CHECK EXISTING ROW
        // =====================================================

        $('#posTable tbody tr')
            .each(function () {

                if (
                    $(this)
                        .find('.qty-value')
                        .length === 0
                ) {
                    return;
                }


                const rowItemId =
                    parseInt(
                        $(this).data('id')
                    ) || 0;


                const rowBatchNo =
                    $(this)
                        .attr('data-batch-no') ||
                    '';


                if (
                    rowItemId === itemId &&
                    rowBatchNo === batchNo
                ) {

                    const rowRate =
                        parseFloat(
                            $(this)
                                .find('.rate')
                                .text()
                        ) || 0;


                    const oldQty =
                        parseFloat(
                            $(this)
                                .find('.qty-value')
                                .text()
                        ) || 0;


                    const newQty =
                        oldQty + qty;


                    if (newQty > stockQty) {

                        Swal.fire(
                            'Stock Limit',
                            `Cannot add more than ${stockQty} items.`,
                            'warning'
                        );

                        return false;
                    }


                    $(this)
                        .find('.qty-value')
                        .text(newQty);


                    $(this)
                        .find('.amount')
                        .text(
                            (
                                newQty *
                                rowRate
                            ).toFixed(2)
                        );


                    found = true;

                    return false;

                }

            });


        // =====================================================
        // ADD NEW ROW
        // =====================================================

        if (!found) {


            if (
                $('#posTable tbody tr')
                    .length === 1 &&
                $('#posTable tbody tr td')
                    .attr('colspan')
            ) {

                $('#posTable tbody')
                    .empty();

            }


            rowIndex++;


            const row = `

                <tr

                    data-id="${itemId}"

                    data-stock="${stockQty}"

                    data-invoice-detail-id="0"

                    data-batch-no="${escapeHtml(batchNo)}"

                    data-mfg-date="${manufacturingDate}"

                    data-expiry-date="${expiryDate}"

                >

                    <td>
                        ${rowIndex}
                    </td>


                    <td class="item-name">

                        ${escapeHtml(itemName)}

                    </td>


                    <td class="rate">

                        ${rate.toFixed(2)}

                    </td>


                    <td>

                        <div class="qty-controls">


                            <button

                                type="button"

                                class="qty-btn qty-minus"

                                onclick="
                                    updateQuantity(this, -1)
                                ">

                                -

                            </button>


                            <span class="qty-value">

                                ${qty}

                            </span>


                            <button

                                type="button"

                                class="qty-btn qty-plus"

                                onclick="
                                    updateQuantity(this, 1)
                                ">

                                +

                            </button>


                        </div>

                    </td>


                    <td class="amount">

                        ${(qty * rate).toFixed(2)}

                    </td>


                    <td>

                        <button

                            type="button"

                            class="delete-btn"

                            onclick="
                                deleteRow(this)
                            ">

                            <i class="fas fa-trash"></i>

                        </button>

                    </td>

                </tr>

            `;


            $('#posTable tbody')
                .append(row);

        }


        calculateTotal();

        resetFields();

    }


    // =========================================================
    // UPDATE QUANTITY
    // =========================================================

    window.updateQuantity = function (btn, delta) {

    const row =
        $(btn).closest('tr');

    const qtySpan =
        row.find('.qty-value');

    const currentQty =
        parseFloat(
            qtySpan.text()
        ) || 0;

    const stockQty =
        parseFloat(
            row.data('stock')
        ) || 999999;

    const newQty =
        currentQty + delta;

    const rate =
        parseFloat(
            row.find('.rate').text()
        ) || 0;


    if (newQty <= 0) {

        deleteRow(btn);

        return;
    }


    // Only relevant for newly added items
    // Existing edit rows are validated in SQL.

    const invoiceDetailId =
        parseInt(
            row.attr('data-invoice-detail-id')
        ) || 0;


    if (
        invoiceDetailId === 0 &&
        newQty > stockQty
    ) {

        Swal.fire(
            'Stock Limit',
            `Only ${stockQty} item(s) available.`,
            'warning'
        );

        return;
    }


    qtySpan.text(newQty);


    row.find('.amount')
        .text(
            (
                newQty * rate
            ).toFixed(2)
        );


    calculateTotal();

};


    // =========================================================
    // DELETE ROW
    // =========================================================

   
window.deleteRow = function (btn) {

    const row = $(btn).closest('tr');

    const invoiceDetailId =
        parseInt(row.attr('data-invoice-detail-id')) || 0;

    const itemName =
        row.find('.item-name')
            .text()
            .trim();

    const quantity =
        parseFloat(
            row.find('.qty-value').text()
        ) || 0;

    // =========================================
    // CHECK EDIT MODE
    // =========================================

    const isEditMode =
        $('#isEditMode').val() === 'true';

    // Existing database item
    const isExistingItem =
        invoiceDetailId > 0;


    // =========================================
    // CONFIRMATION
    // =========================================

    Swal.fire({

        title:
            isExistingItem && isEditMode
                ? 'Delete Item?'
                : 'Remove Item?',

        html:
            isExistingItem && isEditMode

                ? `
                    <b>${escapeHtml(itemName)}</b>
                    <br>
                    Quantity:
                    <b>${quantity}</b>
                    <br><br>
                    This item will be deleted from
                    the invoice and its stock will be restored.
                  `

                : `
                    <b>${escapeHtml(itemName)}</b>
                    <br>
                    Quantity:
                    <b>${quantity}</b>
                    <br><br>
                    This item will be removed
                    from the invoice.
                  `,

        icon: 'warning',

        showCancelButton: true,

        confirmButtonColor: '#ef4444',

        cancelButtonColor: '#6c757d',

        confirmButtonText:
            isExistingItem && isEditMode
                ? 'Yes, Delete'
                : 'Yes, Remove'

    })
    .then(function (result) {

        if (!result.isConfirmed) {
            return;
        }


        // =========================================
        // EXISTING ITEM + EDIT MODE
        // DELETE FROM DATABASE
        // =========================================

        if (isEditMode && isExistingItem) {

            // Disable button to prevent double click
            $(btn).prop('disabled', true);

            Swal.fire({
                title: 'Deleting item...',
                text: 'Please wait.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: function () {
                    Swal.showLoading();
                }
            });


            $.ajax({

                url: '/POS/DeleteInvoiceDetail',

                type: 'POST',

                data: {
                    invoiceDetailId: invoiceDetailId
                },

                success: function (response) {

                    Swal.close();


                    if (response.success) {

                        // Remove from UI only after
                        // database deletion succeeds
                        row.remove();

                        renumberRows();

                        calculateTotal();

                        showEmptyCart();


                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: response.message,
                            timer: 1200,
                            showConfirmButton: false
                        });

                    }
                    else {

                        $(btn).prop('disabled', false);

                        Swal.fire({
                            icon: 'error',
                            title: 'Unable to Delete',
                            text: response.message
                        });

                    }

                },

                error: function (xhr) {

                    Swal.close();

                    $(btn).prop('disabled', false);

                    let message =
                        'Something went wrong while deleting the item.';

                    if (xhr.responseJSON &&
                        xhr.responseJSON.message) {

                        message =
                            xhr.responseJSON.message;
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: message
                    });

                }

            });

            return;
        }


        // =========================================
        // NEW ITEM / NEW SALE
        // ONLY REMOVE FROM UI
        // =========================================

        row.remove();

        renumberRows();

        calculateTotal();

        showEmptyCart();

    });

};



    // =========================================================
    // RENUMBER ROWS
    // =========================================================

    function renumberRows() {

        let counter = 1;


        $('#posTable tbody tr')
            .each(function () {

                if (
                    $(this)
                        .find('.qty-value')
                        .length === 0
                ) {
                    return;
                }


                $(this)
                    .find('td:first')
                    .text(counter++);

            });


        rowIndex =
            counter - 1;

    }


    // =========================================================
    // EMPTY CART
    // =========================================================

    function showEmptyCart() {

        const realRows =
            $('#posTable tbody tr')
                .filter(function () {

                    return $(this)
                        .find('.qty-value')
                        .length > 0;

                });


        if (realRows.length === 0) {

