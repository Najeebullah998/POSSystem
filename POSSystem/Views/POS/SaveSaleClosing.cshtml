<script>

    let closingData = null;


    $(document).ready(function() {

        const today = new Date();
        const closingDate = formatDate(today);

        $('#closingDateText').text(closingDate);

        loadClosingData();

        $('#cashActual').on('input', calculateDifferences);
        $('#easyPaisaActual').on('input', calculateDifferences);
        $('#otherActual').on('input', calculateDifferences);
        $('#openingCash').on('input', calculateDifferences);
    });
    function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');

        return `${year}-${month}-${day}`;
    }

    /* ==========================================
       LOAD SUMMARY
       ========================================== */

    function loadClosingData() {

        const closingDate = formatDate(new Date());

        $('#closingDateText').text(closingDate);

        $.ajax({
            url: '/POS/GetSaleClosingSummary',
            type: 'GET',
            data: {
                closingDate: closingDate
            },
            success: function(res) {

                if (!res || res.totalBills <= 0) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'No sale data found for this date.'
                    }).then(function() {
                        goBack();
                    });

                    return;
                }

                closingData = res;

                renderData(res);
            },
            error: function() {

                Swal.fire(
                    'Error',
                    'Failed to load closing data.',
                    'error'
                );
            }
        });
    }


    /* ==========================================
       RENDER DATA
       ========================================== */

    function renderData(data) {

        const totalBills =
            parseInt(data.totalBills) || 0;

        const grossSales =
            parseFloat(data.grossSales) || 0;

        const totalReturns =
            parseFloat(data.totalReturns) || 0;

        const netAfterReturns =
            parseFloat(data.netAfterReturns) || 0;

        const cash =
            parseFloat(data.cash) || 0;

        const easyPaisa =
            parseFloat(data.easyPaisa) || 0;

        const other =
            parseFloat(data.other) || 0;


        $('#totalBills')
            .text(totalBills);


        $('#totalSales')
            .text(formatAmount(grossSales));


        $('#totalReturns')
            .text(formatAmount(totalReturns));


        $('#netSales')
            .text(formatAmount(netAfterReturns));


        $('#cashSystem')
            .text(formatAmount(cash));


        $('#easyPaisaSystem')
            .text(formatAmount(easyPaisa));


        $('#otherSystem')
            .text(formatAmount(other));


        calculateDifferences();

    }


    /* ==========================================
       CALCULATE DIFFERENCES
       ========================================== */

    function calculateDifferences() {

        if (!closingData)
            return;


        const cashSystem =
            parseFloat(closingData.cash) || 0;

        const easyPaisaSystem =
            parseFloat(closingData.easyPaisa) || 0;

        const otherSystem =
            parseFloat(closingData.other) || 0;


        const cashActual =
            parseFloat($('#cashActual').val()) || 0;

        const easyPaisaActual =
            parseFloat($('#easyPaisaActual').val()) || 0;

        const otherActual =
            parseFloat($('#otherActual').val()) || 0;


        /* PAYMENT DIFFERENCES */

        const cashDifference =
            cashActual - cashSystem;

        const easyPaisaDifference =
            easyPaisaActual - easyPaisaSystem;

        const otherDifference =
            otherActual - otherSystem;


        $('#cashDifference')
            .text(formatAmount(cashDifference));

        $('#easyPaisaDifference')
            .text(formatAmount(easyPaisaDifference));

        $('#otherDifference')
            .text(formatAmount(otherDifference));


        setDifferenceClass(
            '#cashDifference',
            cashDifference
        );


        setDifferenceClass(
            '#easyPaisaDifference',
            easyPaisaDifference
        );


        setDifferenceClass(
            '#otherDifference',
            otherDifference
        );


        /* TOTAL PAYMENTS */

        const totalSystem =
            cashSystem +
            easyPaisaSystem +
            otherSystem;


        const totalActual =
            cashActual +
            easyPaisaActual +
            otherActual;


        const totalDifference =
            totalActual - totalSystem;


        $('#totalSystem')
            .text(formatAmount(totalSystem));


        $('#totalActual')
            .text(formatAmount(totalActual));


        $('#totalDifference')
            .text(formatAmount(totalDifference));


        setDifferenceClass(
            '#totalDifference',
            totalDifference
        );


        /* ACTUAL CASH */

        $('#actualCashDisplay')
            .val(formatAmount(cashActual));


        /* EXPECTED CASH */

        const openingCash =
            parseFloat($('#openingCash').val()) || 0;


        const expectedCash =
            openingCash + cashSystem;


        $('#expectedCash')
            .val(formatAmount(expectedCash));

    }


    /* ==========================================
       DIFFERENCE COLOR
       ========================================== */

    function setDifferenceClass(selector, value) {

        const element = $(selector);


        element.removeClass(
            'positive negative zero'
        );


        if (value > 0) {

            element.addClass('positive');

        }
        else if (value < 0) {

            element.addClass('negative');

        }
        else {

            element.addClass('zero');

        }

    }


    /* ==========================================
       SAVE CLOSING
       ========================================== */

    function saveClosing() {

        if (!closingData) {

            Swal.fire(
                'Warning',
                'Closing data is not loaded.',
                'warning'
            );

            return;
        }


        const cashActual =
            parseFloat($('#cashActual').val()) || 0;

        const easyPaisaActual =
            parseFloat($('#easyPaisaActual').val()) || 0;

        const otherActual =
            parseFloat($('#otherActual').val()) || 0;

        const openingCash =
            parseFloat($('#openingCash').val()) || 0;


        const cashSystem =
            parseFloat(closingData.cash) || 0;


        const expectedCash =
            openingCash + cashSystem;


        const cashDifference =
            cashActual - expectedCash;


        Swal.fire({

            title: 'Save Sale Closing?',

            html:
                'Once saved, this closing will be marked as <b>Closed</b>.',

            icon: 'question',

            showCancelButton: true,

            confirmButtonText: 'Yes, Save Closing',

            cancelButtonText: 'Cancel'

        }).then(function(result) {

            if (!result.isConfirmed)
                return;


            $('#btnSave')
                .prop('disabled', true)
                .html(
                    '<i class="fas fa-spinner fa-spin"></i> Saving...'
                );


            const model = {

                closingDate: formatDate(new Date()),


                openingCash:
                    openingCash,


                totalSales:
                    parseFloat(closingData.grossSales) || 0,


                totalReturns:
                    parseFloat(closingData.totalReturns) || 0,


                netSales:
                    parseFloat(closingData.netAfterReturns) || 0,


                cashSales:
                    cashSystem,


                easyPaisaSales:
                    parseFloat(closingData.easyPaisa) || 0,


                otherSales:
                    parseFloat(closingData.other) || 0,


                expectedCash:
                    expectedCash,


                actualCash:
                    cashActual,


                cashDifference:
                    cashDifference,


                remarks:
                    $('#remarks').val()

            };


            console.log(
                'Sale Closing Save Model:',
                model
            );


            $.ajax({

                url: '/POS/SaveSaleClosing',

                type: 'POST',

                contentType:
                    'application/json; charset=utf-8',

                data:
                    JSON.stringify(model),


                success: function(res) {

                    if (res && res.success) {

                        Swal.fire({

                            icon: 'success',

                            title: 'Closing Saved',

                            html:
                                '<b>Closing No:</b> ' +
                                (res.closingNo || '') +
                                '<br><br>' +
                                'Sale closing saved successfully.',

                            confirmButtonText: 'OK'

                        }).then(function() {

                            window.location.href =
                                '/POS/SaleClosing';

                        });

                    }
                    else {

                        resetSaveButton();


                        Swal.fire(

                            'Error',

                            res.message ||
                            'Unable to save sale closing.',

                            'error'

                        );

                    }

                },


                error: function(xhr) {

                    resetSaveButton();


                    console.log(xhr);


                    let message =
                        'An error occurred while saving closing.';


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    Swal.fire(
                        'Error',
                        message,
                        'error'
                    );

                }

            });

        });

    }


    /* ==========================================
       RESET SAVE BUTTON
       ========================================== */

    function resetSaveButton() {

        $('#btnSave')
            .prop('disabled', false)
            .html(
                '<i class="fas fa-lock"></i> Save Closing'
            );

    }


    /* ==========================================
       FORMAT AMOUNT
       ========================================== */

    function formatAmount(value) {

        value =
            parseFloat(value) || 0;


        return 'Rs ' +
            value.toLocaleString(
                'en-PK',
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );

    }


    /* ==========================================
       NO DATA
       ========================================== */

    function showNoData() {

        Swal.fire({

            icon: 'warning',

            title: 'No Data',

            text:
                'No sale data found for this date.'

        }).then(function() {

            goBack();

        });

    }


    /* ==========================================
       BACK
       ========================================== */

    function goBack() {

        window.history.back();

    }

</script>
