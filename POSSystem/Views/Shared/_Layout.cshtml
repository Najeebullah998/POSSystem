                                        Products
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="Warehouses"
                                       asp-action="AddWarehouse">
                                        Warehouses
                                    </a>
                                </li>

                            </ul>

                        </div>
                    </li>


