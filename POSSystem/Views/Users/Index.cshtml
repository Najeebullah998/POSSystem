@{
    ViewData["Title"] = "CustomerList";
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<div class="page-inner">
    <!-- start page title -->
    <div class="row mb-1">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <div class="input-group ms-1">
                        <input type="text" class="form-control form-control-light" id="dash-daterange">
                        <span class="input-group-text bg-primary border-primary text-white">
                            <i class="mdi mdi-calendar-range font-13"></i>
                        </span>
                    </div>
                </div>
                @* <div class="page-title">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Finance">Customer</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Customer List</li>
                        </ol>
                    </nav>
                </div> *@
            </div>
        </div>
    </div>
    <!-- end page title -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center flex-wrap p-1 pb-0 gap-2">
                    <!-- Left-aligned filter buttons -->
                    <div class="d-flex flex-wrap gap-2">
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">Go Back</a>
                        @* <a href="javascript:void(0);" class="btn btn-primary listbuttons">Yesterday</a>
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">This Month</a>
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">Date Range</a>
                        <a href="javascript:void(0);" class="btn btn-primary listbuttons">All</a> *@
                    </div>
                    <!-- Right-aligned Create New button -->
                    <div>
                        <a onclick="openAddModal()" class="btn btn-primary listbuttons">Create</a>
                    </div>
                </div>
                <div class="card-body">
                    @* <h4 class="header-title mb-3">Grid View</h4> *@
                    <div class="dataTables_wrapper">
                        <table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Role</th>
                                    <th>Branch</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="userTable">
                            </tbody>
                        </table>
                    </div> <!-- end preview-->
                </div> <!-- end card body-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div> <!-- end row-->
</div>
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="userId" value="0" />
                <div class="mb-3">
                    <label for="UserName" class="form-label">User Name</label>
                    <input type="text" class="form-control" id="UserName" placeholder="Enter User Name" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" placeholder="Enter Password" />
                </div>
                <div class="mb-3">
                    <select id="roleId" class="form-control"></select>
                </div>
                <div class="mb-3">
                    <select id="branchId" class="form-control"></select>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsActive" checked>
                    <label class="form-check-label" for="IsActive">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveUser()">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        loadUsers();
        loadRoles();
        loadBranches();
    });

    // LOAD USERS
    function loadUsers() {
        $.get('/Users/GetAllUsers', function (data) {

            let html = '';

                $.each(data, function (i, u) {
                    html += `<tr>
                        <td>${u.userName}</td>
                        <td>${u.roleName}</td>
                        <td>${u.branchName}</td>
                        <td>${u.isActive ? 'Active' : 'Inactive'}</td>
                        <td>
                            <button class="btn btn-sm btn-success" onclick="editUser(${u.userId})">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteUser(${u.userId})">Delete</button>
                        </td>
                    </tr>`;
                });

            $('#userTable').html(html);
        });
    }

    // LOAD ROLES
    function loadRoles() {
        $.get('/Users/GetRoles', function (data) {

            let html = '<option value="">Select Role</option>';

            $.each(data, function (i, r) {
                html += `<option value="${r.roleId}">${r.roleName}</option>`;
            });

            $('#roleId').html(html);
        });
    }

    // LOAD BRANCHES
    function loadBranches() {
        $.get('/Users/GetBranches', function (data) {

            let html = '<option value="">Select Branch</option>';

            $.each(data, function (i, b) {
                html += `<option value="${b.branchId}">${b.branchName}</option>`;
            });

            $('#branchId').html(html);
        });
    }

    // OPEN MODAL
        function openAddModal() {
        $('#userId').val(0);
        $('#UserName').val('');
        $('#password').val('');
        $('#roleId').val('');
        $('#branchId').val('');
        $('#IsActive').prop('checked', true);

        $('#userModal').modal('show');
    }

    // SAVE USER
        function saveUser() {

        let user = {
            UserId: parseInt($('#userId').val()),
            UserName: $('#UserName').val(),
            Password: $('#password').val(),
            RoleId: parseInt($('#roleId').val()),
            BranchId: parseInt($('#branchId').val()),
            IsActive: $('#IsActive').is(':checked')
        };

        let url = user.UserId == 0
            ? '/Users/AddUser'
            : '/Users/UpdateUser';

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(user),
            success: function (res) {

                if (res.success) {
                    $('#userModal').modal('hide');
                    loadUsers();
                } else {
                    alert(res.message);
                }
            }
        });
    }
    // EDIT
        function editUser(id) {
        $.get('/Users/GetUserById?id=' + id, function (data) {

            $('#userId').val(data.userId);
            $('#UserName').val(data.userName);
            $('#roleId').val(data.roleId);
            $('#branchId').val(data.branchId);
            $('#IsActive').prop('checked', data.isActive);

            $('#password').val(''); // don't show password

            $('#userModal').modal('show');
        });
    }

    // DELETE
    function deleteUser(id) {

        if (!confirm('Delete this user?')) return;

        $.post('/Users/DeleteUser?id=' + id, function () {
            loadUsers();
        });
    }
</script>