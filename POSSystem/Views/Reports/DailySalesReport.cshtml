            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- SALES DETAIL TABLE -->
    <!-- ========================= -->

    <div class="card mt-2">

        <!-- TABLE HEADER -->
        <div class="card-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h4 class="header-title mb-0">
                        Sales Details
                    </h4>

                    <small class="text-muted">
                        Invoice-wise sales details
                    </small>
                </div>


                <!-- EXPORT BUTTONS -->
                <div class="d-flex gap-2">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            id="btnPdf">

                        <i class="mdi mdi-file-pdf-box"></i>

                        PDF

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            id="btnExcel">

                        <i class="mdi mdi-file-excel"></i>

                        Excel

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="btnTablePrint">

                        <i class="mdi mdi-printer"></i>

                        Print

                    </button>

                </div>

            </div>

        </div>


        <!-- TABLE BODY -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="salesTable"
                       class="table table-striped table-bordered nowrap"
                       style="width:100%">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Invoice No</th>

                            <th>Date</th>

                            <th>Payment Mode</th>

                            <th>Gross</th>

                            <th>Discount</th>

                            <th>Net</th>

                            <th>Return</th>

                            <th>Net After Return</th>

                            <th>Paid</th>

                        </tr>

                    </thead>


                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>
    ```

</div>

<!-- ====================================================== -->
<!-- DATATABLE BUTTONS -->
<!-- ====================================================== -->

<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

@section Scripts {

    <script>

        // ======================================================
        // DATATABLE VARIABLE
        // ======================================================

        var salesTable = null;


        // ======================================================
        // DOCUMENT READY
        // ======================================================

        $(document).ready(function() {

            setDefaultDates();

            loadDailySalesReport();


            // Search
            $('#btnSearch').click(function() {

                loadDailySalesReport();

            });


            // PDF
            $('#btnPdf').click(function() {

                if (salesTable) {

                    salesTable
                        .button('.buttons-pdf')
                        .trigger();

                }

            });


            // Excel
            $('#btnExcel').click(function() {

                if (salesTable) {

                    salesTable
                        .button('.buttons-excel')
                        .trigger();

                }

            });


            // Print
            $('#btnTablePrint').click(function() {

                if (salesTable) {

                    salesTable
                        .button('.buttons-print')
                        .trigger();

                }

            });

        });


        // ======================================================
        // DEFAULT DATES
        // ======================================================

        function setDefaultDates() {

            var today = new Date();

            var year = today.getFullYear();

            var month =
                String(today.getMonth() + 1)
                    .padStart(2, '0');

            var day =
                String(today.getDate())
                    .padStart(2, '0');


            var todayString =
                year + '-' + month + '-' + day;


            var firstDay =
                year + '-' + month + '-01';


            $('#fromDate').val(firstDay);

            $('#toDate').val(todayString);

        }


        // ======================================================
        // LOAD DAILY SALES REPORT
        // ======================================================

        function loadDailySalesReport() {

            var fromDate =
                $('#fromDate').val();

            var toDate =
                $('#toDate').val();


            if (!fromDate || !toDate) {

                alert('Please select From Date and To Date.');

                return;

            }


            if (fromDate > toDate) {

                alert('From Date cannot be greater than To Date.');

                return;

            }


            $('#btnSearch')
                .prop('disabled', true)
                .html(
                    '<i class="mdi mdi-loading mdi-spin"></i> Loading...'
                );


            $.ajax({

                url: '@Url.Action("GetDailySalesReport", "Reports")',

                type: 'GET',

                data: {

                    fromDate: fromDate,

                    toDate: toDate

                },


                success: function(response) {

                    if (!response.success) {

                        alert(
                            response.message ||
                            'Unable to load report.'
                        );

                        return;

                    }


                    // Bind Summary
                    bindSummary(response.summary);


                    // Bind Details
                    bindDetails(response.details);

                },


                error: function(xhr) {

                    console.log(xhr);

                    alert(
                        'An error occurred while loading the report.'
                    );

                },


                complete: function() {

                    $('#btnSearch')
                        .prop('disabled', false)
                        .html(
                            '<i class="mdi mdi-magnify"></i> Search Report'
                        );

                }

            });

        }


        // ======================================================
        // BIND SUMMARY
        // ======================================================

        function bindSummary(summary) {

            if (!summary) {

                resetSummary();

                return;

            }


            $('#totalBills')
                .text(
                    formatNumber(summary.totalBills)
                );


            $('#grossSales')
                .text(
                    formatAmount(summary.grossSales)
                );


            $('#totalDiscount')
                .text(
                    formatAmount(summary.totalDiscount)
                );


            $('#netSales')
                .text(
                    formatAmount(summary.netSales)
                );


            $('#cashSales')
                .text(
                    formatAmount(summary.cashSales)
                );


            $('#easyPaisaSales')
                .text(
                    formatAmount(summary.easyPaisaSales)
                );


            $('#otherSales')
                .text(
                    formatAmount(summary.otherSales)
                );


            $('#totalPaid')
                .text(
                    formatAmount(summary.totalPaid)
                );


            $('#totalReturns')
                .text(
                    formatAmount(summary.totalReturns)
                );


            $('#netAfterReturns')
                .text(
                    formatAmount(summary.netAfterReturns)
                );

        }


        // ======================================================
        // RESET SUMMARY
        // ======================================================

        function resetSummary() {

            $('#totalBills').text('0');

            $('#grossSales').text('0.00');

            $('#totalDiscount').text('0.00');

            $('#netSales').text('0.00');

            $('#cashSales').text('0.00');

            $('#easyPaisaSales').text('0.00');

            $('#otherSales').text('0.00');

            $('#totalPaid').text('0.00');

            $('#totalReturns').text('0.00');

            $('#netAfterReturns').text('0.00');

        }


        // ======================================================
        // BIND DETAIL TABLE
        // ======================================================

        function bindDetails(details) {

            // Destroy old DataTable
            if ($.fn.DataTable.isDataTable('#salesTable')) {

                $('#salesTable')
                    .DataTable()
                    .clear()
                    .destroy();

            }


            var tbody =
                $('#salesTable tbody');


            tbody.empty();


            if (!details ||
                details.length === 0) {

                initializeEmptyDataTable();

                return;

            }


            // Add rows
            $.each(details, function(index, item) {

                var invoiceDate = '';


                if (item.invoiceDate) {

                    invoiceDate =
                        formatDate(item.invoiceDate);

                }


                var row = `

                        <tr>

                            <td>
                                ${index + 1}
                            </td>


                            <td>
                                <strong>
                                    ${escapeHtml(item.invoiceNo || '')}
                                </strong>
                            </td>


                            <td>
                                ${invoiceDate}
                            </td>


                            <td>
                                ${escapeHtml(item.paymentMode || '')}
                            </td>


                            <td class="text-end">
                                ${formatAmount(item.grossAmount)}
                            </td>


                            <td class="text-end">
                                ${formatAmount(item.discount)}
                            </td>


                            <td class="text-end">
                                ${formatAmount(item.netAmount)}
                            </td>


                            <td class="text-end text-danger">
                                ${formatAmount(item.returnAmount)}
                            </td>


                            <td class="text-end">
                                ${formatAmount(item.netAfterReturn)}
                            </td>


                            <td class="text-end">
                                ${formatAmount(item.paidAmount)}
                            </td>

                        </tr>

                    `;


                tbody.append(row);

            });


            initializeDataTable();

        }


        // ======================================================
        // INITIALIZE DATATABLE
        // ======================================================

        function initializeDataTable() {

            salesTable =
                $('#salesTable').DataTable({

                    pageLength: 25,


                    lengthMenu: [

                        [10, 25, 50, 100, -1],

                        [
                            10,
                            25,
                            50,
                            100,
                            "All"
                        ]

                    ],


                    order: [

                        [2, 'desc']

                    ],


                    responsive: true,


                    dom: 'rtip',


                    buttons: [

                        {
                            extend: 'excelHtml5',

                            className: 'buttons-excel',

                            title: 'Daily Sales Report',

                            filename:
                                'Daily_Sales_Report',

                            exportOptions: {

                                columns: ':visible'

                            }

                        },


                        {
                            extend: 'pdfHtml5',

                            className: 'buttons-pdf',

                            title: 'Daily Sales Report',

                            filename:
                                'Daily_Sales_Report',

                            orientation: 'landscape',

                            pageSize: 'A4',

                            exportOptions: {

                                columns: ':visible'

                            }

                        },


                        {
                            extend: 'print',

                            className: 'buttons-print',

                            title: 'Daily Sales Report',

                            exportOptions: {

                                columns: ':visible'

                            }

                        }

                    ],


                    language: {

                        emptyTable:
                            'No sales found for selected dates.',

                        zeroRecords:
                            'No matching sales found.'

                    }

                });

        }


        // ======================================================
        // EMPTY DATATABLE
        // ======================================================

        function initializeEmptyDataTable() {

            salesTable =
                $('#salesTable').DataTable({

                    pageLength: 25,

                    responsive: true,

                    dom: 'rtip',

                    buttons: [

                        {
                            extend: 'excelHtml5',

                            className: 'buttons-excel',

                            title: 'Daily Sales Report',

                            filename:
                                'Daily_Sales_Report'

                        },


                        {
                            extend: 'pdfHtml5',

                            className: 'buttons-pdf',

                            title: 'Daily Sales Report',

                            filename:
                                'Daily_Sales_Report',

                            orientation: 'landscape',

                            pageSize: 'A4'

                        },


                        {
                            extend: 'print',

                            className: 'buttons-print',

                            title: 'Daily Sales Report'

                        }

                    ],


                    language: {

                        emptyTable:
                            'No sales found for selected dates.'

                    }

                });

        }


        // ======================================================
        // FORMAT AMOUNT
        // ======================================================

        function formatAmount(value) {

            if (value === null ||
                value === undefined ||
                value === '') {

                return '0.00';

            }


            var number =
                parseFloat(value);


            if (isNaN(number)) {

                return '0.00';

            }


            return number.toLocaleString(
                'en-US',
                {
                    minimumFractionDigits: 2,

                    maximumFractionDigits: 2
                }
            );

        }


        // ======================================================
        // FORMAT NUMBER
        // ======================================================

        function formatNumber(value) {

            if (value === null ||
                value === undefined ||
                value === '') {

                return '0';

            }


            var number =
                parseInt(value);


            if (isNaN(number)) {

                return '0';

            }


            return number.toLocaleString('en-US');

        }


        // ======================================================
        // FORMAT DATE
        // ======================================================

        function formatDate(value) {

            var date =
                new Date(value);


            if (isNaN(date.getTime())) {

                return '';

            }


            var day =
                String(date.getDate())
                    .padStart(2, '0');


            var month =
                String(date.getMonth() + 1)
                    .padStart(2, '0');


            var year =
                date.getFullYear();


            return day +
                '-' +
                month +
                '-' +
                year;

        }


        // ======================================================
        // ESCAPE HTML
        // ======================================================

        function escapeHtml(value) {

            return $('<div>')
                .text(value)
                .html();

        }

    </script>

    <style>

        .page-title {
            font-weight: 600;
        }


        .avatar-sm {
            width: 40px;
            height: 40px;
        }


        .avatar-title {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
        }


        #salesTable th {
            white-space: nowrap;
        }


        #salesTable td {
            vertical-align: middle;
        }


        .card-header {
            padding: 1rem 1.25rem;
        }


        /* Hide DataTables built-in buttons.
               We are using our own buttons. */

        .dt-buttons {
            display: none !important;
        }


        /* Mobile */

        @@media (max-width: 767px) {

            .card-header .d-flex {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 10px;
            }


                .card-header .d-flex > div:last-child {
                    width: 100%;
                }


            #btnPdf,
            #btnExcel,
            #btnTablePrint {
                flex: 1;
            }
        }


        /* PRINT */

        @@media print {

            body * {
                visibility: hidden !important;
            }


            #salesTable,
            #salesTable * {
                visibility: visible !important;
            }


            #salesTable {
                position: absolute;
                left: 0;
                top: 0;
                width: 100% !important;
            }


                #salesTable th,
                #salesTable td {
                    font-size: 11px;
                }


            .dataTables_length,
            .dataTables_filter,
            .dataTables_info,
            .dataTables_paginate,
            .dt-buttons {
                display: none !important;
            }
        }

    </style>

}
