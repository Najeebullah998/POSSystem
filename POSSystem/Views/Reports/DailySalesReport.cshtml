        <!-- DISCOUNT -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h5 class="text-muted fw-normal mt-0">
                                Discount
                            </h5>

                            <h3 class="my-2"
                                id="totalDiscount">
                                0.00
                            </h3>
                        </div>

                        <div class="avatar-sm">
                            <span class="avatar-title bg-warning rounded">
                                <i class="mdi mdi-tag-outline font-22"></i>
                            </span>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- NET SALES -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h5 class="text-muted fw-normal mt-0">
                                Net Sales
                            </h5>

                            <h3 class="my-2"
                                id="netSales">
                                0.00
                            </h3>
                        </div>

                        <div class="avatar-sm">
                            <span class="avatar-title bg-info rounded">
                                <i class="mdi mdi-chart-line font-22"></i>
                            </span>
                        </div>

