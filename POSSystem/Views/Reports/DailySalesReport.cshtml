@{
    ViewData["Title"] = "Daily Sales Report";
}

<div class="container-fluid">

    ```
    <!-- PAGE HEADER -->
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="page-title">Daily Sales Report</h4>
            <p class="text-muted mb-0">
                Sales summary and invoice-wise details
