    <!-- ========================= -->
    <!-- RETURN SUMMARY -->
    <!-- ========================= -->

    <div class="row">

        <!-- RETURNS -->
        <div class="col-xl-6">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="text-muted fw-normal mt-0">
                                Total Returns
                            </h5>

                            <h3 class="text-danger"
                                id="totalReturns">
                                0.00
                            </h3>

                        </div>

                        <div class="avatar-sm">

                            <span class="avatar-title bg-danger rounded">

                                <i class="mdi mdi-backup-restore font-22"></i>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- NET AFTER RETURNS -->
        <div class="col-xl-6">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="text-muted fw-normal mt-0">
                                Net After Returns
                            </h5>

                            <h3 class="text-success"
                                id="netAfterReturns">
                                0.00
                            </h3>

                        </div>

                        <div class="avatar-sm">

                            <span class="avatar-title bg-success rounded">

                                <i class="mdi mdi-cash-check font-22"></i>

                            </span>

                        </div>

                    </div>

