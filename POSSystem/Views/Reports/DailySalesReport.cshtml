                </div>
            </div>
        </div>


        <!-- GROSS SALES -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h5 class="text-muted fw-normal mt-0">
                                Gross Sales
