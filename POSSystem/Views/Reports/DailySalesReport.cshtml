            <div class="card">
                <div class="card-body">

                    <h5 class="text-muted fw-normal mt-0">
                        Other Payments
                    </h5>

                    <h3 id="otherSales">
                        0.00
                    </h3>

                </div>
            </div>
        </div>


        <!-- TOTAL PAID -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <h5 class="text-muted fw-normal mt-0">
                        Total Paid
                    </h5>

                    <h3 id="totalPaid">
                        0.00
                    </h3>

                </div>
            </div>
        </div>

