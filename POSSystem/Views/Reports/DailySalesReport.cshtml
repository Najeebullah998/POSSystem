    <!-- ========================= -->
    <!-- PAYMENT SUMMARY -->
    <!-- ========================= -->

    <div class="row">

        <!-- CASH -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <h5 class="text-muted fw-normal mt-0">
                        Cash Sales
                    </h5>

                    <h3 id="cashSales">
                        0.00
                    </h3>

                </div>
            </div>
        </div>


        <!-- EASYPAISA -->
        <div class="col-xl-3 col-md-6">
            <div class="card">
                <div class="card-body">

                    <h5 class="text-muted fw-normal mt-0">
                        EasyPaisa
                    </h5>

                    <h3 id="easyPaisaSales">
                        0.00
                    </h3>

                </div>
            </div>
        </div>


        <!-- OTHER -->
