                    </div>
                    <div class="stat-label">Today's Customers</div>
                    <div class="stat-value" id="todayCustomers">0</div>
                    <div class="stat-sub">Unique customers today</div>
                </div>
            </div>
           @*  <div class="col-lg-4 col-md-6">
                <div class="stat-card" style="border-left-color: var(--success-color);">
                    <div class="stat-icon success">
                        <i class="mdi mdi-cart"></i>
                    </div>
                    <div class="stat-label">Items Sold</div>
                    <div class="stat-value" id="itemsSold">0</div>
                    <div class="stat-sub">Total quantity sold</div>
                </div>
            </div> *@
            <div class="col-lg-4 col-md-12">
                <div class="stat-card" style="border-left-color: var(--warning-color);">
                    <div class="stat-icon warning">
                        <i class="mdi mdi-trending-up"></i>
                    </div>
                    <div class="stat-label">Average Bill</div>
                    <div class="stat-value" id="averageBill">Rs. 0</div>
                    <div class="stat-sub">Per bill average</div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ===== END CONTENT ===== -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    let dashboardData = null;
    let updateCount = 0;
    let isAutoRefreshEnabled = true;
    let refreshInterval = null;

    $(document).ready(function() {
        // Set today's date
        const today = new Date();
        $('#todayDate').text(today.toLocaleDateString('en-US', {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        }));

        // Load dashboard
        loadDashboard();

        // Start auto refresh every 2 seconds
        startAutoRefresh();

        // Toggle auto refresh
        $('#toggleAutoRefresh').on('click', function() {
            if (isAutoRefreshEnabled) {
                pauseAutoRefresh();
                $(this).html('<i class="mdi mdi-play"></i> Resume');
                $(this).removeClass('btn-success').addClass('btn-warning');
            } else {
                startAutoRefresh();
                $(this).html('<i class="mdi mdi-pause"></i> Pause');
                $(this).removeClass('btn-warning').addClass('btn-success');
            }
        });
    });

    function startAutoRefresh() {
        isAutoRefreshEnabled = true;
        // Clear any existing interval
        if (refreshInterval) {
            clearInterval(refreshInterval);
        }
        // Start new interval every 2 seconds
        refreshInterval = setInterval(function() {
            if (isAutoRefreshEnabled) {
                refreshDashboard();
            }
        }, 2000);

        // Update live indicator
        $('#liveIndicator').show();
    }

    function pauseAutoRefresh() {
        isAutoRefreshEnabled = false;
        if (refreshInterval) {
            clearInterval(refreshInterval);
            refreshInterval = null;
        }
        $('#liveIndicator').hide();
    }

    function refreshDashboard() {
        // Don't show loading spinner for auto refresh
        const companyId = @(ViewBag.CompanyId ?? 0);
        const branchId = @(ViewBag.BranchId ?? 0);
        const userId = @(ViewBag.UserId ?? 0);

        $.ajax({
            url: '/Home/GetDashboardSummary',
            type: 'GET',
            data: {
                companyId: companyId,
                branchId: branchId,
                userId: userId
            },
            success: function(res) {
                if (res.success) {
                    updateCount++;
                    $('#updateCount').text('(' + updateCount + ')');
                    dashboardData = res.data;
                    renderDashboard(res.data, true); // true = silent update
                }
            },
            error: function() {
                // Silent fail - don't show error on auto refresh
            }
        });
    }

    function loadDashboard() {
        $('#loadingState').show();
        $('#dashboardContent').hide();

        const companyId = @(ViewBag.CompanyId ?? 0);
        const branchId = @(ViewBag.BranchId ?? 0);
        const userId = @(ViewBag.UserId ?? 0);

        $.ajax({
            url: '/Home/GetDashboardSummary',
            type: 'GET',
            data: {
                companyId: companyId,
                branchId: branchId,
                userId: userId
            },
            success: function(res) {
                $('#loadingState').hide();

                if (res.success) {
                    dashboardData = res.data;
                    renderDashboard(res.data, false);
                    $('#dashboardContent').show();
                } else {
                    Swal.fire('Error', res.message || 'Failed to load dashboard', 'error');
                }
            },
            error: function() {
                $('#loadingState').hide();
                Swal.fire('Error', 'Failed to load dashboard data', 'error');
            }
        });
    }

    function renderDashboard(data, silent) {
        // Get all value elements
        const elements = {
            totalBills: $('#totalBills'),
            grossSales: $('#grossSales'),
            totalDiscount: $('#totalDiscount'),
            netSales: $('#netSales'),
            totalReturns: $('#totalReturns'),
            netAfterReturns: $('#netAfterReturns'),
            totalPayments: $('#totalPayments'),
            cashSales: $('#cashSales'),
            easyPaisaSales: $('#easyPaisaSales'),
            otherSales: $('#otherSales'),
            totalPaymentsSummary: $('#totalPaymentsSummary'),
            averageBill: $('#averageBill'),
            todayCustomers: $('#todayCustomers'),
            itemsSold: $('#itemsSold')
        };

        // Update values with animation
        updateValue(elements.totalBills, data.totalBills || 0, silent);
        updateValue(elements.grossSales, 'Rs. ' + formatNumber(data.grossSales || 0), silent);
        updateValue(elements.totalDiscount, 'Rs. ' + formatNumber(data.totalDiscount || 0), silent);
        updateValue(elements.netSales, 'Rs. ' + formatNumber(data.netSales || 0), silent);
        updateValue(elements.totalReturns, 'Rs. ' + formatNumber(data.totalReturns || 0), silent);
        updateValue(elements.netAfterReturns, 'Rs. ' + formatNumber(data.netAfterReturns || 0), silent);
        updateValue(elements.totalPayments, 'Rs. ' + formatNumber(data.totalPayments || 0), silent);
        updateValue(elements.cashSales, 'Rs. ' + formatNumber(data.cashSales || 0), silent);
        updateValue(elements.easyPaisaSales, 'Rs. ' + formatNumber(data.easyPaisaSales || 0), silent);
        updateValue(elements.otherSales, 'Rs. ' + formatNumber(data.otherSales || 0), silent);
        updateValue(elements.totalPaymentsSummary, 'Rs. ' + formatNumber(data.totalPayments || 0), silent);

        // Calculate quick stats
        const totalBills = data.totalBills || 0;
        const netSales = data.netSales || 0;
        const avgBill = totalBills > 0 ? netSales / totalBills : 0;

        updateValue(elements.averageBill, 'Rs. ' + formatNumber(avgBill), silent);
        updateValue(elements.todayCustomers, totalBills, silent);
        updateValue(elements.itemsSold, totalBills * 3, silent);

        // Update last updated time
        const now = new Date();
        if (!silent) {
            $('#lastUpdated').text(now.toLocaleTimeString());
        } else {
            $('#lastUpdated').text(now.toLocaleTimeString() + ' (auto)');
        }
    }

    function updateValue(element, newValue, silent) {
        const currentValue = element.text();
        if (currentValue !== newValue.toString()) {
            element.text(newValue);
            if (!silent) {
                // Add animation for manual updates
                element.addClass('updated');
                element.closest('.stat-card').addClass('updating');
                setTimeout(() => {
                    element.removeClass('updated');
                    element.closest('.stat-card').removeClass('updating');
                }, 500);
            }
        }
    }

    function formatNumber(num) {
        // Format number with commas for thousands
        return num.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }
</script>