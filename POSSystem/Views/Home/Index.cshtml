                        <span><i class="mdi mdi-credit-card-multiple"></i> Payment Summary</span>
                        <span style="font-size: 13px; opacity: 0.9;">Today's payments</span>
                    </div>
                    <div class="card-body-custom">
                        <div class="row">
                            <div class="col-md-3 col-6">
                                <div class="payment-card">
                                    <span class="payment-icon">💵</span>
                                    <div class="payment-label">Cash</div>
                                    <div class="payment-value cash" id="cashSales">Rs. 0</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
