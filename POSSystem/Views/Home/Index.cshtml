                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card" style="border-left-color: var(--primary-color);">
                    <div class="stat-icon purple">
                        <i class="mdi mdi-chart-line"></i>
                    </div>
                    <div class="stat-label">Net After Returns</div>
                    <div class="stat-value" id="netAfterReturns">Rs. 0</div>
                    <div class="stat-sub">Final sales</div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card" style="border-left-color: var(--success-color);">
                    <div class="stat-icon success">
                        <i class="mdi mdi-credit-card"></i>
                    </div>
                    <div class="stat-label">Total Payments</div>
                    <div class="stat-value" id="totalPayments">Rs. 0</div>
                    <div class="stat-sub">All payments</div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card" style="border-left-color: var(--warning-color);">
                    <div class="stat-icon warning">
