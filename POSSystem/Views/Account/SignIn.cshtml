@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Log In | POS - Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="POS Admin Dashboard sign in" name="description" />
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
            :root {
                --ink: #14231F;
                --ink-soft: #55665F;
                --paper: #F6F5F0;
                --panel: #FFFFFF;
                --line: #E4E1D6;
                --teal: #0B6E4F;
                --teal-deep: #084F39;
                --amber: #E8A33D;
                --danger: #B4442E;
                --radius: 10px;
            }

            * {
                box-sizing: border-box;
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation-duration: 0.001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.001ms !important;
                }
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                color: var(--ink);
                background: var(--paper);
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            @@media (max-width: 900px) {
                body {
                    grid-template-columns: 1fr;
                }

                .brand-panel {
                    display: none;
                }
            }

            /* ---------- Left: form ---------- */
            .form-panel {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 48px 32px;
            }

            .form-wrap {
                width: 100%;
                max-width: 380px;
                opacity: 0;
                transform: translateY(10px);
                animation: riseIn 0.55s cubic-bezier(.2,.7,.3,1) 0.05s forwards;
            }

            @@keyframes riseIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .logo-mark {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 44px;
            }

                .logo-mark .chip {
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    background: var(--teal);
                    position: relative;
                    flex: none;
                }

                    .logo-mark .chip::after {
                        content: "";
                        position: absolute;
                        inset: 8px 8px 12px 8px;
                        border-bottom: 2px solid var(--amber);
                    }

                .logo-mark span {
                    font-family: 'Space Grotesk', sans-serif;
                    font-weight: 700;
                    font-size: 17px;
                    letter-spacing: 0.01em;
                }

            h1 {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 600;
                font-size: 28px;
                margin: 0 0 8px;
                letter-spacing: -0.01em;
            }

            .subtitle {
                color: var(--ink-soft);
                font-size: 14.5px;
                margin: 0 0 32px;
                line-height: 1.5;
            }

            .field {
                margin-bottom: 18px;
            }

                .field label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    margin-bottom: 7px;
                    color: var(--ink);
                }

            .input-shell {
                position: relative;
                display: flex;
                align-items: center;
            }

                .input-shell svg {
                    position: absolute;
                    left: 13px;
                    width: 16px;
                    height: 16px;
                    color: #A6A79A;
                    pointer-events: none;
                    transition: color .15s ease;
                }

                .input-shell:focus-within svg {
                    color: var(--teal);
                }

            .field input {
                width: 100%;
                padding: 12px 14px 12px 38px;
                font-size: 14.5px;
                font-family: inherit;
                border: 1.5px solid var(--line);
                border-radius: var(--radius);
                background: var(--panel);
                color: var(--ink);
                outline: none;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

                .field input::placeholder {
                    color: #A6A79A;
                }

                .field input:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px rgba(11,110,79,0.14);
                }

                .field input.is-invalid {
                    border-color: var(--danger);
                    animation: shake 0.32s ease;
                }

            @@keyframes shake {
                25% {
                    transform: translateX(-4px);
                }

                75% {
                    transform: translateX(4px);
                }
            }

            .toggle-pw {
                position: absolute;
                right: 12px;
                background: none;
                border: none;
                padding: 2px;
                cursor: pointer;
                color: #A6A79A;
                display: flex;
                transition: color .15s ease;
            }

                .toggle-pw:hover {
                    color: var(--teal-deep);
                }

                .toggle-pw svg {
                    position: static;
                }

            .row-between {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 6px;
            }

                .row-between label {
                    margin-bottom: 0;
                }

            .forgot {
                font-size: 13px;
                color: var(--teal-deep);
                text-decoration: none;
                font-weight: 500;
            }

                .forgot:hover {
                    text-decoration: underline;
                }

            .remember {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 6px 0 26px;
                font-size: 13.5px;
                color: var(--ink-soft);
            }

                .remember input {
                    width: 15px;
                    height: 15px;
                    accent-color: var(--teal);
                }

            .alert-banner {
                display: none;
                align-items: center;
                gap: 8px;
                background: #FCEEE9;
                border: 1px solid #F0C6B8;
                color: var(--danger);
                font-size: 13px;
                padding: 10px 12px;
                border-radius: 8px;
                margin-bottom: 18px;
            }

            .btn-signin {
                width: 100%;
                border: none;
                border-radius: var(--radius);
                background: var(--teal);
                color: #fff;
                font-family: inherit;
                font-size: 15px;
                font-weight: 600;
                padding: 13px 16px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                transition: background .15s ease, transform .05s ease;
            }

                .btn-signin:hover {
                    background: var(--teal-deep);
                    box-shadow: 0 6px 16px rgba(11,110,79,0.25);
                }

                .btn-signin:active {
                    transform: translateY(1px);
                }

                .btn-signin:disabled {
                    background: #5F9C87;
                    cursor: not-allowed;
                    box-shadow: none;
                }

            .spinner {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid rgba(255,255,255,0.4);
                border-top-color: #fff;
                animation: spin 0.7s linear infinite;
                display: none;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .btn-signin.is-loading .spinner {
                display: inline-block;
            }

            .btn-signin.is-loading .btn-label {
                opacity: 0.9;
            }

            .btn-signin.is-success {
                background: var(--teal-deep);
            }

            .check-icon {
                width: 16px;
                height: 16px;
                display: none;
            }

            .btn-signin.is-success .check-icon {
                display: inline-block;
                animation: popIn 0.3s ease;
            }

            .btn-signin.is-success .spinner {
                display: none;
            }

            @@keyframes popIn {
                from {
                    transform: scale(0.5);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .divider {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #A6A79A;
                font-size: 12.5px;
                margin: 28px 0 20px;
            }

                .divider::before, .divider::after {
                    content: "";
                    flex: 1;
                    height: 1px;
                    background: var(--line);
                }

            .social-row {
                display: flex;
                gap: 10px;
                margin-bottom: 32px;
            }

                .social-row a {
                    flex: 1;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    height: 40px;
                    border: 1.5px solid var(--line);
                    border-radius: 8px;
                    color: var(--ink-soft);
                    font-size: 13px;
                    text-decoration: none;
                    font-weight: 500;
                    transition: border-color .15s ease, color .15s ease;
                }

                    .social-row a:hover {
                        border-color: var(--teal);
                        color: var(--teal-deep);
                    }

            .footer-line {
                font-size: 13.5px;
                color: var(--ink-soft);
                text-align: center;
            }

                .footer-line a {
                    color: var(--teal-deep);
                    font-weight: 600;
                    text-decoration: none;
                }

                    .footer-line a:hover {
                        text-decoration: underline;
                    }

            /* ---------- Right: brand panel ---------- */
            .brand-panel {
                position: relative;
                background: var(--teal-deep);
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                padding: 40px;
            }

                .brand-panel::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.06), transparent 45%), radial-gradient(circle at 80% 75%, rgba(232,163,61,0.14), transparent 40%);
                }

            .drift {
                position: absolute;
                border-radius: 50%;
                background: var(--amber);
                opacity: 0.16;
                animation: drift 9s ease-in-out infinite;
            }

                .drift.d1 {
                    width: 90px;
                    height: 90px;
                    top: 12%;
                    left: 12%;
                    animation-delay: 0s;
                }

                .drift.d2 {
                    width: 46px;
                    height: 46px;
                    bottom: 18%;
                    right: 14%;
                    background: #fff;
                    opacity: 0.08;
                    animation-delay: 1.5s;
                }

                .drift.d3 {
                    width: 22px;
                    height: 22px;
                    top: 30%;
                    right: 22%;
                    animation-delay: 3s;
                }

            @@keyframes drift {
                0%, 100% {
                    transform: translateY(0) translateX(0);
                }

                50% {
                    transform: translateY(-18px) translateX(8px);
                }
            }

            .receipt-stage {
                position: relative;
                animation: floatStage 5s ease-in-out infinite;
            }

            @@keyframes floatStage {
                0%, 100% {
                    transform: rotate(-2deg) translateY(0);
                }

                50% {
                    transform: rotate(-1deg) translateY(-6px);
                }
            }

            .printer-nub {
                width: 92px;
                height: 14px;
                margin: 0 auto -2px;
                background: #0A5B41;
                border-radius: 5px 5px 0 0;
                position: relative;
                box-shadow: inset 0 -3px 4px rgba(0,0,0,0.2);
            }

                .printer-nub::after {
                    content: "";
                    position: absolute;
                    top: 4px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 34px;
                    height: 4px;
                    background: rgba(0,0,0,0.25);
                    border-radius: 2px;
                }

            .receipt {
                position: relative;
                width: 260px;
                background: #FBFAF6;
                border-radius: 4px;
                padding: 26px 22px 22px;
                box-shadow: 0 30px 60px rgba(0,0,0,0.35);
                font-family: 'Space Grotesk', sans-serif;
                color: #23322C;
            }

                .receipt::before, .receipt::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    height: 10px;
                    background: repeating-linear-gradient(90deg, transparent, transparent 8px, #FBFAF6 8px, #FBFAF6 14px), var(--teal-deep);
                }

                .receipt::before {
                    top: -6px;
                }

                .receipt::after {
                    bottom: -6px;
                }

                .receipt .r-title {
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    text-align: center;
                    margin-bottom: 3px;
                }

                .receipt .r-sub {
                    font-size: 10.5px;
                    text-align: center;
                    color: #7C8A82;
                    margin-bottom: 16px;
                    font-family: 'Inter', sans-serif;
                }

            .r-line {
                display: flex;
                justify-content: space-between;
                font-size: 11.5px;
                font-family: 'Inter', sans-serif;
                padding: 5px 0;
                border-bottom: 1px dashed #DDD9CB;
                opacity: 0;
                animation: printLine 0.4s ease forwards;
            }

                .r-line:nth-child(3) {
                    animation-delay: 0.2s;
                }

                .r-line:nth-child(4) {
                    animation-delay: 0.5s;
                }

                .r-line:nth-child(5) {
                    animation-delay: 0.8s;
                }

                .r-line:nth-child(6) {
                    animation-delay: 1.1s;
                }

            @@keyframes printLine {
                from {
                    opacity: 0;
                    transform: translateY(-4px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .r-total {
                display: flex;
                justify-content: space-between;
                font-size: 13px;
                font-weight: 700;
                margin-top: 12px;
                padding-top: 10px;
                border-top: 1.5px solid #23322C;
            }

            .brand-copy {
                position: absolute;
                bottom: 48px;
                left: 48px;
                right: 48px;
                color: #EDEAE0;
            }

                .brand-copy h2 {
                    font-family: 'Space Grotesk', sans-serif;
                    font-size: 21px;
                    font-weight: 600;
                    margin: 0 0 8px;
                }

                .brand-copy p {
                    font-size: 13.5px;
                    line-height: 1.6;
                    color: #B9CBC3;
                    margin: 0;
                    max-width: 320px;
                }
    </style>
</head>

<body>

    <div class="form-panel">
        <div class="form-wrap">
            <div class="logo-mark">
                <span class="chip"></span>
                <span>POS Admin</span>
            </div>

            <h1>Welcome back</h1>
            <p class="subtitle">Sign in to manage orders, inventory, and staff from one dashboard.</p>

            <div class="alert-banner" id="alertBanner"></div>

            <form id="loginForm" novalidate>
                <div class="field">
                    <label for="emailaddress">Email address</label>
                    <div class="input-shell">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5v-11Z" stroke-linecap="round" stroke-linejoin="round" /><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <input class="form-control" type="email" id="emailaddress" name="username" placeholder="you@business.com" autocomplete="username">
                    </div>
                </div>

                <div class="field">
                    <div class="row-between">
                        <label for="password">Password</label>
                        <a href="pages-recoverpw-2.html" class="forgot">Forgot password?</a>
                    </div>
                    <div class="input-shell">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4.5" y="10.5" width="15" height="9.5" rx="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M7.5 10.5V7.8a4.5 4.5 0 0 1 9 0v2.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <input class="form-control" type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password">
                        <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password">
                            <svg id="eyeIcon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </div>
                </div>

                <div class="remember">
                    <input type="checkbox" id="checkbox-signin">
                    <label for="checkbox-signin">Keep me signed in on this device</label>
                </div>

                <button class="btn-signin" type="button" id="btnLogin">
                    <span class="spinner"></span>
                    <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span class="btn-label">Sign in</span>
                </button>
            </form>

            <div class="divider">or continue with</div>
            <div class="social-row">
                <a href="javascript:void(0);" title="Continue with Facebook" aria-label="Continue with Facebook">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33V22c4.78-.8 8.44-4.94 8.44-9.94Z" /></svg>
                </a>
                <a href="javascript:void(0);" title="Continue with Google" aria-label="Continue with Google">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v2.9h5.35c-.23 1.5-1.65 4.4-5.35 4.4-3.22 0-5.85-2.66-5.85-5.95S8.78 6.5 12 6.5c1.83 0 3.06.78 3.76 1.45l2.56-2.47C16.7 3.9 14.55 3 12 3 6.98 3 2.9 7.06 2.9 12.06s4.08 9.06 9.1 9.06c5.25 0 8.74-3.69 8.74-8.9 0-.6-.07-1.06-.14-1.5Z" /></svg>
                </a>
                <a href="javascript:void(0);" title="Continue with GitHub" aria-label="Continue with GitHub">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.5 2.87 8.31 6.84 9.66.5.1.68-.22.68-.5v-1.94c-2.78.62-3.37-1.36-3.37-1.36-.46-1.2-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.92.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.9-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.92-2.35 4.79-4.58 5.04.36.32.68.94.68 1.9v2.82c0 .28.18.61.69.5A10.03 10.03 0 0 0 22 12.19C22 6.58 17.52 2 12 2Z" /></svg>
                </a>
            </div>

            <p class="footer-line">Don't have an account? <a href="pages-register-2.html">Create one</a></p>
        </div>
    </div>

    <div class="brand-panel">
        <span class="drift d1"></span>
        <span class="drift d2"></span>
        <span class="drift d3"></span>

        <div class="receipt-stage">
            <div class="printer-nub"></div>
            <div class="receipt">
                <div class="r-title">Daily Summary</div>
                <div class="r-sub">Store #04 · Today</div>
                <div class="r-line"><span>Orders processed</span><span>128</span></div>
                <div class="r-line"><span>Items sold</span><span>342</span></div>
                <div class="r-line"><span>Refunds</span><span>2</span></div>
                <div class="r-line"><span>Staff on shift</span><span>5</span></div>
                <div class="r-total"><span>Net sales</span><span>$4,180</span></div>
            </div>
        </div>

        <div class="brand-copy">
            <h2>Run the whole counter from here.</h2>
            <p>Orders, inventory, and staff, synced in real time across every till in the store.</p>
        </div>
    </div>

    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/js/app.min.js"></script>

    <script>
            $(function() {
                var $btn = $('#btnLogin');
                var $alert = $('#alertBanner');
                var $email = $('#emailaddress');
                var $password = $('#password');
                var $togglePw = $('#togglePw');
                var $eyeIcon = $('#eyeIcon');

                var EYE_OPEN = '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round"/>';
                var EYE_OFF = '<path d="M3 3l18 18" stroke-linecap="round"/><path d="M9.9 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a15.6 15.6 0 0 1-3.3 4.2M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.3 0 2.5-.2 3.6-.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.9 14.1a3 3 0 0 0 4.2-4.2" stroke-linecap="round" stroke-linejoin="round"/>';

                $togglePw.on('click', function() {
                    var isPw = $password.attr('type') === 'password';
                    $password.attr('type', isPw ? 'text' : 'password');
                    $eyeIcon.html(isPw ? EYE_OFF : EYE_OPEN);
                    $togglePw.attr('aria-label', isPw ? 'Hide password' : 'Show password');
                });

                function showError(message) {
                    $alert.text(message).css('display', 'flex');
                }

                function clearError() {
                    $alert.hide().text('');
                    $email.removeClass('is-invalid');
                    $password.removeClass('is-invalid');
                }

                function setLoading(isLoading) {
                    $btn.prop('disabled', isLoading);
                    $btn.toggleClass('is-loading', isLoading);
                    $btn.find('.btn-label').text(isLoading ? 'Signing in…' : 'Sign in');
                }

                function setSuccess() {
                    $btn.removeClass('is-loading').addClass('is-success');
                    $btn.find('.btn-label').text('Signed in');
                }

                $btn.on('click', function() {
                    clearError();

                    var username = $email.val().trim();
                    var password = $password.val();

                    if (!username) {
                        $email.addClass('is-invalid');
                        showError('Enter your email address to continue.');
                        return;
                    }
                    if (!password) {
                        $password.addClass('is-invalid');
                        showError('Enter your password to continue.');
                        return;
                    }

                    setLoading(true);

                    $.ajax({
                        url: '/Account/Login',
                        type: 'POST',
                        data: { username: username, password: password },
                        success: function(response) {
                            if (response.success) {
                                setSuccess();
                                setTimeout(function() {
                                    window.location.href = '/Home/Index';
                                }, 450);
                            } else {
                                setLoading(false);
                                showError(response.message || 'Invalid email or password.');
                            }
                        },
                        error: function() {
                            setLoading(false);
                            showError('Something went wrong. Please try again.');
                        }
                    });
                });

                // Allow Enter key to submit from either field
                $email.add($password).on('keypress', function(e) {
                    if (e.which === 13) { $btn.trigger('click'); }
                });
            });
    </script>

</body>
</html>
