@model POSSystem.Entities.SaleReturnHeaderVM

@* @{
    ViewBag.Title = "Sale Return";
} *@

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<style>
    :root {
        --primary-color: #4361ee;
        --primary-dark: #3a56d4;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --dark-color: #1f2937;
        --light-bg: #f9fafb;
        --border-color: #e5e7eb;
        --return-color: #dc2626;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding-bottom: 120px;
        min-height: 100vh;
    }

    .return-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Cards */
    .return-card {
        background: white;
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .return-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        }

    .card-header-return {
        background: linear-gradient(135deg, var(--warning-color) 0%, #d97706 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: 0.5px;
    }

    .card-header-success {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        padding: 15px 25px;
        color: white;
        font-weight: 600;
        font-size: 16px;
    }

    .card-body-custom {
        padding: 25px;
    }

    /* Form Elements */
    .form-label-modern {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
    }

    .form-control-modern {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 12px;
        transition: all 0.3s;
        font-size: 14px;
        width: 100%;
    }

        .form-control-modern:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            outline: none;
        }

        .form-control-modern:disabled, .form-control-modern[readonly] {
            background: #f3f4f6;
            cursor: not-allowed;
        }

    textarea.form-control-modern {
        resize: vertical;
        min-height: 60px;
    }

    /* Select2 Custom */
    .select2-container .select2-selection--single {
        border: 2px solid var(--border-color);
        border-radius: 10px;
        height: 44px;
        padding: 5px;
    }

    .select2-container--focus .select2-selection--single {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }

    .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 32px;
        padding-left: 8px;
    }

    .select2-container .select2-selection--single .select2-selection__arrow {
        height: 40px;
    }

    /* Invoice Selection Section */
    .invoice-selection-section {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 2px solid var(--warning-color);
    }

    /* Table Styles */
    .table-wrapper {
        max-height: calc(100vh - 500px);
        overflow-y: auto;
        border-radius: 12px;
        background: white;
        border: 1px solid var(--border-color);
    }

    .return-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .return-table thead th {
            background: var(--dark-color);
            color: white;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px;
            position: sticky;
            top: 0;
            z-index: 10;
            border: none;
        }

        .return-table tbody tr {
            transition: all 0.2s;
            border-bottom: 1px solid var(--border-color);
        }

            .return-table tbody tr:hover {
                background: #fffbeb;
                transform: scale(1.01);
            }

        .return-table tbody td {
            padding: 12px 15px;
            vertical-align: middle;
        }

        .return-table .qty-input {
            width: 100px;
            text-align: center;
            border-radius: 8px;
            border: 2px solid var(--border-color);
            padding: 6px 10px;
            transition: all 0.3s;
        }

            .return-table .qty-input:focus {
                border-color: var(--warning-color);
                box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
                outline: none;
            }

            .return-table .qty-input:disabled {
                background: #f3f4f6;
                cursor: not-allowed;
            }

    /* Status Badges */
    .badge-status {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-approved {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-rejected {
        background: #fecaca;
        color: #991b1b;
    }

    .badge-partial {
        background: #dbeafe;
        color: #1e40af;
    }

    /* Footer Section */
    .return-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 3px solid var(--warning-color);
        box-shadow: 0 -5px 20px rgba(0,0,0,0.15);
        z-index: 1000;
        padding: 20px 30px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        align-items: center;
    }

    .footer-card {
        background: var(--light-bg);
        padding: 12px 18px;
        border-radius: 12px;
        transition: all 0.3s;
    }

        .footer-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

    .footer-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 3px;
    }

    .footer-value {
        font-size: 22px;
        font-weight: 700;
        color: var(--dark-color);
        margin: 0;
    }

    .footer-value-warning {
        color: var(--warning-color);
    }

    .btn-save-return {
        background: linear-gradient(135deg, var(--warning-color) 0%, #d97706 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .btn-save-return:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 158, 11, 0.3);
        }

    .btn-clear-return {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        width: 100%;
        transition: all 0.3s;
    }

        .btn-clear-return:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

    /* Animations */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .return-table tbody tr {
        animation: slideIn 0.3s ease-out;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }

        .return-container {
            padding: 10px;
        }

        .return-footer {
            padding: 15px;
        }
    }

    /* Print Styles */
    @@media print {
        body * {
            visibility: hidden;
        }

        #printArea, #printArea * {
            visibility: visible;
        }

        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: white;
            padding: 20px;
        }
    }

    /* Return Reason Input */
    .return-reason-input {
        border: 2px solid var(--border-color);
        border-radius: 8px;
        padding: 6px 10px;
        width: 100%;
        font-size: 13px;
        transition: all 0.3s;
    }

        .return-reason-input:focus {
            border-color: var(--warning-color);
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
            outline: none;
        }
</style>


<input type="hidden" id="invoiceId" value="@ViewBag.InvoiceId" />
<input type="hidden" id="isEditMode" value="true" />
<div class="return-container">
    <!-- Return Header Card -->
    <div class="return-card">
        <div class="card-header-return">
            <i class="fas fa-undo-alt"></i> Sale Return Note
        </div>
        <div class="card-body-custom">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-hashtag"></i> Return Number
                    </label>
                    <input type="text" id="ReturnNumber" class="form-control-modern" value="@Model.ReturnNumber" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="far fa-calendar-alt"></i> Return Date
                    </label>
                    <input type="date" id="ReturnDate" class="form-control-modern" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-file-invoice"></i> Invoice Reference
                    </label>
                    <select id="InvoiceId" class="form-control-modern select2">
                        <option value="">Select Invoice</option>
                        @if (Model.InvoiceList != null)
                        {
                            foreach (var item in Model.InvoiceList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label-modern">
                        <i class="fas fa-user"></i> Customer
                    </label>
                    <select id="CustomerId" class="form-control-modern select2">
                        <option value="">Select Customer</option>
                        @if (Model.CustomerList != null)
                        {
                            foreach (var item in Model.CustomerList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label-modern">
                        <i class="fas fa-warehouse"></i> Warehouse
                    </label>
                    <select asp-for="WarehouseId"
                            asp-items="Model.WarehouseList"
                            class="form-control-modern select2"
                            id="WarehouseId">
                        <option value="">Select Warehouse</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Return Items Card -->
    <div class="return-card">
        <div class="card-header-return">
            <i class="fas fa-boxes"></i> Items to Return
        </div>
        <div class="card-body-custom">
            <!-- Invoice Selection Info -->
            <div class="invoice-selection-section">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <i class="fas fa-info-circle" style="color: #92400e;"></i>
                        <span style="font-weight: 600; color: #92400e;">Select an Invoice to load items for return</span>
                        <span id="invoiceInfo" style="margin-left: 15px; color: #6b7280;"></span>
                    </div>
                    <div class="col-md-4 text-end">
                        <button class="btn btn-warning" onclick="loadInvoiceItems()" style="border-radius: 10px; color: white;">
                            <i class="fas fa-sync-alt"></i> Load Invoice Items
                        </button>
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-wrapper">
                <table class="return-table" id="returnTable">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="18%">Item Name</th>
                            <th width="9%">Sold Qty</th>
                            <th width="9%">Already Returned</th>
                            <th width="9%">Available Qty</th>
                            <th width="9%">Return Qty</th>
                            <th width="9%">Rate (Rs)</th>
                            <th width="9%">Amount (Rs)</th>
                            <th width="14%">Return Reason</th>
                            <th width="9%">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-center">
                            <td colspan="10" style="padding: 60px 20px;">
                                <i class="fas fa-undo-alt" style="font-size: 48px; color: #cbd5e1;"></i>
                                <p style="color: #94a3b8; margin-top: 15px;">Select an Invoice and click "Load Invoice Items" to begin</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Remarks Card -->
    <div class="return-card">
        <div class="card-body-custom">
            <div class="row">
                <div class="col-md-12">
                    <label class="form-label-modern">
                        <i class="fas fa-comment"></i> Remarks / Notes
                    </label>
                    <textarea id="Remarks" class="form-control-modern" rows="2" placeholder="Enter any remarks about this return..."></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer Section -->
<div class="return-footer">
    <div class="footer-grid">
        <div class="footer-card">
            <div class="footer-label">Total Items</div>
            <div class="footer-value" id="totalItems">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Total Sold Qty</div>
            <div class="footer-value" id="totalSoldQty">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Return Qty</div>
            <div class="footer-value footer-value-warning" id="totalReturnQty">0</div>
        </div>

        <div class="footer-card">
            <div class="footer-label">Return Amount (Rs)</div>
            <div class="footer-value footer-value-warning" id="totalAmount">0.00</div>
        </div>

        <div>
            <button class="btn-save-return" onclick="saveReturn()">
                <i class="fas fa-save"></i> Save Return
            </button>
        </div>

        <div>
            <button class="btn-clear-return" onclick="clearAll()">
                <i class="fas fa-trash-alt"></i> Clear
            </button>
        </div>
    </div>
</div>

<!-- Print Template -->
<div id="printArea" style="display:none;">
    <div style="padding: 20px;">
        <h2 style="text-align: center; color: #d97706;">Sale Return Note</h2>
        <hr style="border: 2px solid #d97706;">
        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <tr>
                <td><strong>Return #:</strong> <span id="pReturnNumber"></span></td>
                <td><strong>Date:</strong> <span id="pReturnDate"></span></td>
            </tr>
            <tr>
                <td><strong>Customer:</strong> <span id="pCustomer"></span></td>
                <td><strong>Invoice #:</strong> <span id="pInvoiceNumber"></span></td>
            </tr>
            <tr>
                <td><strong>Warehouse:</strong> <span id="pWarehouse"></span></td>
                <td><strong>Status:</strong> <span id="pStatus">Pending</span></td>
            </tr>
        </table>

        <table style="width: 100%; border-collapse: collapse; margin-top: 20px; border: 1px solid #000;">
            <thead>
                <tr style="background: #d97706; color: white;">
                    <th style="padding: 8px; border: 1px solid #000;">#</th>
                    <th style="padding: 8px; border: 1px solid #000;">Item</th>
                    <th style="padding: 8px; border: 1px solid #000;">Sold Qty</th>
                    <th style="padding: 8px; border: 1px solid #000;">Return Qty</th>
                    <th style="padding: 8px; border: 1px solid #000;">Rate</th>
                    <th style="padding: 8px; border: 1px solid #000;">Amount</th>
                    <th style="padding: 8px; border: 1px solid #000;">Reason</th>
                </tr>
            </thead>
            <tbody id="printItems"></tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="padding: 8px; border: 1px solid #000; text-align: right;"><strong>Total Return Amount:</strong></td>
                    <td colspan="2" style="padding: 8px; border: 1px solid #000;" id="pTotalAmount"></td>
                </tr>
            </tfoot>
        </table>

        <p style="margin-top: 20px;"><strong>Remarks:</strong> <span id="pRemarks"></span></p>
        <hr style="border: 1px solid #ddd; margin-top: 30px;">
        <p style="text-align: center; color: #6b7280; font-size: 12px;">This is a computer generated document</p>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>

<script>
    let returnItems = [];
    let rowIndex = 0;

    $(document).ready(function() {

        const invoiceId = parseInt($('#invoiceId').val()) || 0;
        const isEditMode = $('#isEditMode').val() === 'True' ||
            $('#isEditMode').val() === 'true';

        if (isEditMode && invoiceId > 0) {

            console.log("EDIT MODE - InvoiceId:", invoiceId);

            loadBillForEdit(invoiceId);

        } else {

            // =========================
            // NEW BILL MODE
            // =========================

            if (!$('#invoiceDate').val()) {
                $('#invoiceDate').val(
                    new Date().toISOString().split('T')[0]
                );
            }

            let invoiceNo =
                'INV-' + new Date().getTime().toString().slice(-8);

            $('#invoiceNo').val(invoiceNo);

            $('#barcodeInput').focus();
        }

    });

    $(document).ready(function() {

        const invoiceId = parseInt($('#invoiceId').val()) || 0;
        const isEditMode = $('#isEditMode').val() === 'true';

        console.log("Invoice ID:", invoiceId);
        console.log("Edit Mode:", isEditMode);

        if (isEditMode && invoiceId > 0) {

            console.log("Loading Edit Bill:", invoiceId);

            loadBillForEdit(invoiceId);

        } else {

            console.log("New Sale Mode");

            if (!$('#invoiceDate').val()) {
                $('#invoiceDate').val(
                    new Date().toISOString().split('T')[0]
                );
            }

            let invoiceNo =
                'INV-' + new Date().getTime().toString().slice(-8);

            $('#invoiceNo').val(invoiceNo);

            $('#barcodeInput').focus();
        }
    });
    $(document).ready(function() {

        $('.select2').select2({
            placeholder: 'Select option',
            allowClear: true,
            width: '100%'
        });

        var invoiceId = '@ViewBag.InvoiceId';

        if (invoiceId && invoiceId !== '0') {

            $('#InvoiceId')
                .val(invoiceId)
                .trigger('change');

            loadInvoiceItems();
        }
    });
    $(document).ready(function() {
        // Initialize Select2
        $('.select2').select2({
            placeholder: 'Select option',
            allowClear: true,
            width: '100%'
        });

        // Load Invoice details when selected
        // $('#InvoiceId').on('change', function() {
        //     let invoiceId = $(this).val();
        //     if (invoiceId) {
        //         loadInvoiceDetails(invoiceId);
        //     } else {
        //         $('#invoiceInfo').text('');
        //     }
        // });
    });

    function loadInvoiceDetails(invoiceId) {
        $.ajax({
            url: '/SaleReturn/GetInvoiceForSaleReturn', // ✅ Updated controller name
            type: 'GET',
            data: { invoiceId: invoiceId },
            success: function(res) {
                if (res.success && res.data) {
                    let data = res.data;
                    $('#invoiceInfo').text(`Invoice #: ${data.invoiceNumber} | Customer: ${data.customerName}`);

                    // Auto-select customer
                    if (data.customerId) {
                        $('#CustomerId').val(data.customerId).trigger('change');
                    }

                    // Auto-select warehouse
                    if (data.warehouseId) {
                        $('#WarehouseId').val(data.warehouseId).trigger('change');
                    }
                }
            },
            error: function() {
                console.log('Failed to load invoice details');
            }
        });
    }

    function loadInvoiceItems() {
        let invoiceId = $('#InvoiceId').val();

        if (!invoiceId) {
            Swal.fire('Warning', 'Please select an Invoice first!', 'warning');
            return;
        }

        Swal.fire({
            title: 'Loading...',
            text: 'Please wait while we load invoice items',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/SaleReturn/GetInvoiceForSaleReturn', // ✅ Using same endpoint
            type: 'GET',
            data: { invoiceId: invoiceId },
            success: function(res) {
                Swal.close();

                if (res.success && res.data) {
                    let data = res.data;

                    // Auto Customer
                    // if (data.customerId) {
                    //     $('#CustomerId')
                    //         .val(data.customerId)
                    //         .trigger('change');
                    // }

                    // // Auto Warehouse
                    if (data.warehouseId) {
                        $('#WarehouseId')
                            .val(data.warehouseId)
                            .trigger('change');
                    }

                    returnItems = data.details;
                    renderTable(data.details);
                    calculateTotals();

                    Swal.fire({
                        icon: 'success',
                        title: 'Loaded!',
                        text: `${data.details.length} items loaded`,
                        timer: 1500
                    });
                } else {
                    Swal.fire('Info', res.message || 'No items found', 'info');
                }
            },
            error: function() {
                Swal.close();
                Swal.fire('Error', 'Failed to load invoice items', 'error');
            }
        });
    }

    function renderTable(items) {
        let tbody = $('#returnTable tbody');
        tbody.empty();
        rowIndex = 0;

        if (!items || items.length === 0) {
            tbody.html(`
                    <tr class="text-center">
                        <td colspan="10" style="padding: 60px 20px;">
                            <i class="fas fa-undo-alt" style="font-size: 48px; color: #cbd5e1;"></i>
                            <p style="color: #94a3b8; margin-top: 15px;">No items available for return</p>
                        </td>
                    </tr>
                `);
            return;
        }

        items.forEach(function(item) {
            rowIndex++;

            let row = `
                    <tr data-itemid="${item.itemId}" data-saleinvoicedetailid="${item.saleInvoiceDetailId}">
                        <td>${rowIndex}</td>
                        <td class="item-name">${item.itemName}</td>
                        <td class="sold-qty">${item.quantity}</td>
                        <td class="already-returned">${item.returnedQty || 0}</td>
                        <td class="available-qty">${item.availableQty}</td>
                        <td>
                            <input type="number"
                                   class="qty-input return-qty"
                                   value="0"
                                   min="0"
                                   max="${item.availableQty}"
                                   onchange="updateRow(this)" />
                        </td>
                        <td class="rate">Rs ${parseFloat(item.rate).toFixed(2)}</td>
                        <td class="amount">Rs 0.00</td>
                        <td>
                            <input type="text"
                                   class="return-reason-input return-reason"
                                   placeholder="Enter reason..." />
                        </td>
                        <td class="status-cell">
                            <span class="badge-status" style="background:#e5e7eb;color:#6b7280;">
                                No Return
                            </span>
                        </td>
                    </tr>
                `;
            tbody.append(row);
        });
    }

    function updateRow(input) {
        let row = $(input).closest('tr');
        let availableQty = parseFloat(row.find('.available-qty').text()) || 0;
        let returnQty = parseFloat($(input).val()) || 0;
        let rate = parseFloat(row.find('.rate').text().replace('Rs ', '')) || 0;

        // Validate return quantity
        if (returnQty > availableQty) {
            $(input).val(availableQty);
            returnQty = availableQty;
            Swal.fire('Warning', 'Return quantity cannot exceed available quantity', 'warning');
        }

        // Calculate amount
        let amount = returnQty * rate;
        row.find('.amount').text(`Rs ${amount.toFixed(2)}`);

        // Update status
        if (returnQty > 0) {
            if (returnQty == availableQty) {
                row.find('.status-cell').html(`
                        <span class="badge-status badge-approved">Full Return</span>
                    `);
            } else {
                row.find('.status-cell').html(`
                        <span class="badge-status badge-partial">Partial Return</span>
                    `);
            }
        } else {
            row.find('.status-cell').html(`
                    <span class="badge-status" style="background:#e5e7eb;color:#6b7280;">
                        No Return
                    </span>
                `);
        }

        calculateTotals();
    }

    // Update on reason change
    $(document).on('change', '.return-reason', function() {
        // Just track the reason - no calculation needed
    });

    function calculateTotals() {
        let totalItems = 0;
        let totalSoldQty = 0;
        let totalReturnQty = 0;
        let totalAmount = 0;

        $('#returnTable tbody tr').each(function() {
            let soldQty = parseFloat($(this).find('.sold-qty').text()) || 0;
            let returnQty = parseFloat($(this).find('.return-qty').val()) || 0;
            let amount = parseFloat($(this).find('.amount').text().replace('Rs ', '')) || 0;

            if (soldQty > 0) {
                totalItems++;
                totalSoldQty += soldQty;
                totalReturnQty += returnQty;
                totalAmount += amount;
            }
        });

        $('#totalItems').text(totalItems);
        $('#totalSoldQty').text(totalSoldQty);
        $('#totalReturnQty').text(totalReturnQty);
        $('#totalAmount').text(totalAmount.toFixed(2));
    }

    function saveReturn() {
        // Validations
        if (!$('#InvoiceId').val()) {
            Swal.fire('Validation Error', 'Please select an Invoice', 'error');
            return;
        }

        // if (!$('#CustomerId').val(1)) {
        //     Swal.fire('Validation Error', 'Please select a Customer', 'error');
        //     return;
        // }

        // if (!$('#WarehouseId').val(2)) {
        //     Swal.fire('Validation Error', 'Please select a Warehouse', 'error');
        //     return;
        // }
        // console.log('CustomerId', $('#CustomerId').val());
        // console.log('WarehouseId', $('#WarehouseId').val());
        let details = [];
        let hasItems = false;

        $('#returnTable tbody tr').each(function() {
            let saleInvoiceDetailId = $(this).data('saleinvoicedetailid');
            let itemId = $(this).data('itemid');
            let returnQty = parseFloat($(this).find('.return-qty').val()) || 0;
            let rate = parseFloat($(this).find('.rate').text().replace('Rs ', '')) || 0;
            let reason = $(this).find('.return-reason').val() || '';

            if (returnQty > 0) {
                hasItems = true;
                details.push({
                    SaleInvoiceDetailId: saleInvoiceDetailId,
                    ItemId: itemId,
                    ReturnQty: returnQty,
                    Rate: rate,
                    Amount: returnQty * rate,
                    Reason: reason
                });
            }
        });

        if (!hasItems) {
            Swal.fire('Validation Error', 'Please return at least one item', 'error');
            return;
        }

        let model = {
            ReturnNumber: $('#ReturnNumber').val(),
            ReturnDate: $('#ReturnDate').val(),
            InvoiceId: $('#InvoiceId').val(),
            CustomerId: 1,
            WarehouseId: 2,
            BranchId: 1, // Add BranchId if needed
            TotalAmount: parseFloat($('#totalAmount').text()),
            Remarks: $('#Remarks').val(),
            CreatedBy: 1, // Add CreatedBy if needed
            Details: details
        };
        console.log('Model to save:', model);
        Swal.fire({
            title: 'Saving...',
            text: 'Please wait while we save the return',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/SaleReturn/SaveSaleReturn', // ✅ Updated controller name
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(model),
            success: function(res) {
                if (res.success) {
                    preparePrint(model);
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: res.message || 'Sale Return saved successfully',
                        confirmButtonColor: '#d97706'
                    }).then(() => {
                        window.print();
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    });
                } else {
                    Swal.fire('Error', res.message || 'Failed to save return', 'error');
                }
            },
            error: function() {
                Swal.close();
                Swal.fire('Error', 'An error occurred while saving', 'error');
            }
        });
    }

    function preparePrint(model) {
        $('#pReturnNumber').text(model.ReturnNumber);
        $('#pReturnDate').text(model.ReturnDate);
        $('#pCustomer').text($('#CustomerId option:selected').text());
        $('#pInvoiceNumber').text($('#InvoiceId option:selected').text());
        $('#pWarehouse').text($('#WarehouseId option:selected').text());
        $('#pTotalAmount').text(`Rs ${model.TotalAmount.toFixed(2)}`);
        $('#pRemarks').text(model.Remarks || 'N/A');

        let rows = '';
        let index = 1;

        $('#returnTable tbody tr').each(function() {
            let item = $(this).find('.item-name').text();
            let soldQty = $(this).find('.sold-qty').text();
            let returnQty = $(this).find('.return-qty').val() || 0;
            let rate = $(this).find('.rate').text();
            let amount = $(this).find('.amount').text();
            let reason = $(this).find('.return-reason').val() || '-';

            if (returnQty > 0) {
                rows += `
                        <tr>
                            <td style="padding: 6px; border: 1px solid #000;">${index++}</td>
                            <td style="padding: 6px; border: 1px solid #000;">${item}</td>
                            <td style="padding: 6px; border: 1px solid #000; text-align: center;">${soldQty}</td>
                            <td style="padding: 6px; border: 1px solid #000; text-align: center;">${returnQty}</td>
                            <td style="padding: 6px; border: 1px solid #000; text-align: right;">${rate}</td>
                            <td style="padding: 6px; border: 1px solid #000; text-align: right;">${amount}</td>
                            <td style="padding: 6px; border: 1px solid #000;">${reason}</td>
                        </tr>
                    `;
            }
        });

        $('#printItems').html(rows);
    }

    function clearAll() {
        Swal.fire({
            title: 'Clear All?',
            text: "This will remove all items from the return",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d97706',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, clear all!'
        }).then((result) => {
            if (result.isConfirmed) {
                $('#returnTable tbody').html(`
                        <tr class="text-center">
                            <td colspan="10" style="padding: 60px 20px;">
                                <i class="fas fa-undo-alt" style="font-size: 48px; color: #cbd5e1;"></i>
                                <p style="color: #94a3b8; margin-top: 15px;">Select an Invoice and click "Load Invoice Items" to begin</p>
                            </td>
                        </tr>
                    `);
                $('#invoiceInfo').text('');
                $('#Remarks').val('');
                calculateTotals();
                Swal.fire('Cleared!', 'All items have been cleared.', 'success');
            }
        });
    }
</script>